@model PoWorks_Rework.Models.TenantViewModel

@if (Model.SelectedTenant.Id <= 0)
{
    <div class="alert alert-info">Create or select a tenant to see its meters and consumption context.</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Assigned meters</div>
                    <div class="fs-4 fw-semibold">@Model.ConsumptionData.Meters.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Billed outstanding</div>
                    <div class="fs-4 fw-semibold">@Model.ConsumptionData.TotalBilledOutstanding.ToString("0.00")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Overdue</div>
                    <div class="fs-4 fw-semibold">@Model.ConsumptionData.Overdue.ToString("0.00")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div>
                <strong>Assigned meters</strong>
                <div class="small text-muted">Meters linked to this tenant in the current workspace.</div>
            </div>
            <a asp-controller="Meter" asp-action="Management" class="btn btn-sm btn-outline-primary">Open Meter Management</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Meter</th>
                        <th>Unit</th>
                        <th>Last Reading</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.ConsumptionData.Meters.Any())
                {
                    @foreach (var meter in Model.ConsumptionData.Meters)
                    {
                        <tr>
                            <td>
                                <div>@meter.Name</div>
                                <small class="text-muted">#@meter.Id</small>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(meter.Unit) ? "—" : meter.Unit)</td>
                            <td>@meter.LastReading</td>
                            <td>
                                @if (meter.Active)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            No meter is assigned to this tenant yet.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="alert alert-light border">
        Historical comparison charts will use the meter readings assigned to this tenant. The meter list is now live; historical aggregation is handled in the next end-to-end data phase.
    </div>
}
