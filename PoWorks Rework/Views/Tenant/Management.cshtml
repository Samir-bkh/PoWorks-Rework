@model PoWorks_Rework.Models.TenantViewModel
@{
    ViewData["Title"] = "Tenant Management";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1">Tenant Management</h3>
            <p class="text-muted mb-0">Manage tenants, lifecycle, tariffs and workspace-scoped meter assignments.</p>
        </div>
        <a asp-controller="TenantManagement" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New Tenant
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Tenant" asp-action="Search" method="get" id="searchForm" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="searchCriteria">Search by</label>
                    <select class="form-select" id="searchCriteria" name="searchCriteria">
                        <option value="Company Name" selected="@(Model.SearchCriteria == "Company Name")">Company Name</option>
                        <option value="Contact" selected="@(Model.SearchCriteria == "Contact")">Contact</option>
                        <option value="Email" selected="@(Model.SearchCriteria == "Email")">Email</option>
                        <option value="Phone" selected="@(Model.SearchCriteria == "Phone")">Phone</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="searchTerm">Search</label>
                    <input class="form-control" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" placeholder="Tenant company, contact, email or phone..." />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">Search</button>
                    <a asp-controller="Tenant" asp-action="Management" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Tenants</strong>
            <span class="text-muted small">@Model.TotalItems total</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Company</th>
                        <th>Contact</th>
                        <th>Email</th>
                        <th class="text-center">Meters</th>
                        <th class="text-center">Users</th>
                        <th class="text-center">Bills</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.SearchResults.Any())
                {
                    @foreach (var tenant in Model.SearchResults)
                    {
                        <tr class="@(tenant.Id == Model.SelectedTenant?.Id ? "table-primary" : "")">
                            <td>
                                <strong>@tenant.CompanyName</strong>
                                @if (!string.IsNullOrWhiteSpace(tenant.Phone))
                                {
                                    <div class="small text-muted">@tenant.Phone</div>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(tenant.Contact) ? "—" : tenant.Contact)</td>
                            <td>@(string.IsNullOrWhiteSpace(tenant.Email) ? "—" : tenant.Email)</td>
                            <td class="text-center">@tenant.AssignedMeterCount</td>
                            <td class="text-center">@tenant.UserCount</td>
                            <td class="text-center">@tenant.BillCount</td>
                            <td>
                                @if (tenant.Active)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Tenant" asp-action="Management" asp-route-id="@tenant.Id" class="btn btn-sm btn-outline-primary">Open</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No tenants found.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                <span class="small text-muted">Page @Model.CurrentPage of @Model.TotalPages</span>
                <div class="btn-group">
                    <a class="btn btn-sm btn-outline-secondary @(Model.CurrentPage <= 1 ? "disabled" : "")"
                       asp-controller="Tenant" asp-action="Search"
                       asp-route-searchCriteria="@Model.SearchCriteria"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                    <a class="btn btn-sm btn-outline-secondary @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                       asp-controller="Tenant" asp-action="Search"
                       asp-route-searchCriteria="@Model.SearchCriteria"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                </div>
            </div>
        }
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tenant-management" type="button">Tenant</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#consumption" type="button">Meters & Consumption</button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="tenant-management">
            <partial name="~/Views/Tenant/_TenantManagement.cshtml" model="Model" />
        </div>
        <div class="tab-pane fade" id="consumption">
            <partial name="~/Views/Tenant/_Consumption.cshtml" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tenant-scripts.js"></script>
}
