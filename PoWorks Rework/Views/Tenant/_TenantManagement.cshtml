@model PoWorks_Rework.Models.TenantViewModel

<form asp-controller="TenantManagement" asp-action="SaveTenant" method="post" id="tenantForm">
    <input type="hidden" name="Id" value="@Model.SelectedTenant.Id" />

    @if (Model.SelectedTenant.Id > 0)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="mb-0">@Model.SelectedTenant.CompanyName</h5>
                        @if (Model.SelectedTenant.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Disabled</span>
                        }
                    </div>
                    <div class="small text-muted mt-1">
                        @Model.Dependencies.UserCount user(s) ·
                        @Model.Dependencies.MeterCount meter(s) ·
                        @Model.Dependencies.BillCount bill(s) ·
                        @Model.Dependencies.PaymentCount payment(s)
                    </div>
                </div>
                <div class="d-flex gap-2">
                    @if (Model.SelectedTenant.Active)
                    {
                        <button type="submit"
                                class="btn btn-outline-warning"
                                formaction="@Url.Action("DisableTenant", "TenantManagement")"
                                name="tenantId" value="@Model.SelectedTenant.Id">
                            Disable
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="btn btn-outline-success"
                                formaction="@Url.Action("EnableTenant", "TenantManagement")"
                                name="tenantId" value="@Model.SelectedTenant.Id">
                            Enable
                        </button>
                    }

                    <button type="submit"
                            class="btn btn-outline-danger"
                            formaction="@Url.Action("DeleteTenant", "TenantManagement")"
                            name="tenantId" value="@Model.SelectedTenant.Id"
                            disabled="@(!Model.Dependencies.CanDelete ? "disabled" : null)"
                            title="@(Model.Dependencies.CanDelete ? "Delete this empty tenant" : "Disable the tenant instead. Permanent deletion is blocked while linked data exists.")"
                            onclick="return confirm('Permanently delete this empty tenant?');">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    }

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white"><strong>Tenant details</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="companyName" class="form-label">Company Name *</label>
                    <input type="text" class="form-control" id="companyName" name="CompanyName" value="@Model.SelectedTenant.CompanyName" required maxlength="100" />
                </div>
                <div class="col-md-6">
                    <label for="contact" class="form-label">Contact</label>
                    <input type="text" class="form-control" id="contact" name="Contact" value="@Model.SelectedTenant.Contact" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" name="Email" value="@Model.SelectedTenant.Email" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label for="phone" class="form-label">Phone</label>
                    <input type="text" class="form-control" id="phone" name="Phone" value="@Model.SelectedTenant.Phone" maxlength="20" />
                </div>
                <div class="col-md-4">
                    <label for="unit" class="form-label">Unit / Building</label>
                    <input type="text" class="form-control" id="unit" name="Unit" value="@Model.SelectedTenant.Unit" maxlength="100" />
                </div>
                <div class="col-md-6">
                    <label for="address1" class="form-label">Address 1</label>
                    <input type="text" class="form-control" id="address1" name="Address1" value="@Model.SelectedTenant.Address1" maxlength="255" />
                </div>
                <div class="col-md-6">
                    <label for="address2" class="form-label">Address 2</label>
                    <input type="text" class="form-control" id="address2" name="Address2" value="@Model.SelectedTenant.Address2" maxlength="255" />
                </div>
                <div class="col-md-4">
                    <label for="postCode" class="form-label">Post Code</label>
                    <input type="text" class="form-control" id="postCode" name="PostCode" value="@Model.SelectedTenant.PostCode" maxlength="20" />
                </div>
                <div class="col-md-4">
                    <label for="city" class="form-label">City</label>
                    <input type="text" class="form-control" id="city" name="City" value="@Model.SelectedTenant.City" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" class="form-control" id="startDate" name="StartDate" value="@Model.SelectedTenant.StartDate" />
                </div>
                <div class="col-md-6">
                    <label for="period" class="form-label">Billing Period</label>
                    <select class="form-select" id="period" name="Period">
                        @foreach (var period in new[] { "Daily", "Weekly", "Monthly", "Quarterly", "Yearly" })
                        {
                            <option value="@period" selected="@(Model.SelectedTenant.Period == period)">@period</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="active" name="Active" value="true" @(Model.SelectedTenant.Active ? "checked" : "") />
                        <input type="hidden" name="Active" value="false" />
                        <label class="form-check-label" for="active">Active tenant</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white"><strong>Tariff</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="tariffType" class="form-label">Type</label>
                    <select class="form-select" id="tariffType" name="TariffType">
                        <option value="Company" selected="@(Model.SelectedTenant.TariffType == "Company")">Company</option>
                        <option value="Personal" selected="@(Model.SelectedTenant.TariffType == "Personal")">Personal</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="baseRate" class="form-label">Base Rate</label>
                    <input type="number" min="0" step="0.0001" class="form-control" id="baseRate" name="BaseRate" value="@Model.SelectedTenant.BaseRate" />
                </div>
                <div class="col-md-4">
                    <label for="deposit" class="form-label">Deposit</label>
                    <input type="number" min="0" step="0.01" class="form-control" id="deposit" name="Deposit" value="@Model.SelectedTenant.Deposit" />
                </div>
                <div class="col-md-4">
                    <label for="monthlyFee" class="form-label">Monthly Fixed Fee</label>
                    <input type="number" min="0" step="0.01" class="form-control" id="monthlyFee" name="MonthlyFee" value="@Model.SelectedTenant.MonthlyFee" />
                    <div class="form-text">Included by the current billing engine on generated bills.</div>
                </div>
                <div class="col-md-3">
                    <label for="threshold1" class="form-label">Threshold 1</label>
                    <input type="number" min="0" step="0.001" class="form-control" id="threshold1" name="Threshold1" value="@Model.SelectedTenant.Threshold1" />
                </div>
                <div class="col-md-3">
                    <label for="threshold1Rate" class="form-label">Threshold 1 Rate</label>
                    <input type="number" min="0" step="0.0001" class="form-control" id="threshold1Rate" name="Threshold1Rate" value="@Model.SelectedTenant.Threshold1Rate" />
                </div>
                <div class="col-md-3">
                    <label for="threshold2" class="form-label">Threshold 2</label>
                    <input type="number" min="0" step="0.001" class="form-control" id="threshold2" name="Threshold2" value="@Model.SelectedTenant.Threshold2" />
                </div>
                <div class="col-md-3">
                    <label for="threshold2Rate" class="form-label">Threshold 2 Rate</label>
                    <input type="number" min="0" step="0.0001" class="form-control" id="threshold2Rate" name="Threshold2Rate" value="@Model.SelectedTenant.Threshold2Rate" />
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white"><strong>Notifications & billing delivery</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="emailAlert" name="EmailAlert" value="true" @(Model.SelectedTenant.EmailAlert ? "checked" : "") />
                        <input type="hidden" name="EmailAlert" value="false" />
                        <label class="form-check-label" for="emailAlert">Email alerts</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="printBill" name="PrintBill" value="true" @(Model.SelectedTenant.PrintBill ? "checked" : "") />
                        <input type="hidden" name="PrintBill" value="false" />
                        <label class="form-check-label" for="printBill">Print bills</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="emailBill" name="EmailBill" value="true" @(Model.SelectedTenant.EmailBill ? "checked" : "") />
                        <input type="hidden" name="EmailBill" value="false" />
                        <label class="form-check-label" for="emailBill">Email bills</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-4">
        <a asp-controller="Tenant" asp-action="Management" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-success">Save Tenant</button>
    </div>
</form>
