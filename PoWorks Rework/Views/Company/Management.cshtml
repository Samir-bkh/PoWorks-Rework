@model PoWorks_Rework.Controllers.CompanyAdminViewModel
@{
    ViewData["Title"] = "Workspaces";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Workspaces</h2>
            <p class="text-muted mb-0">Create and manage isolated customer / site workspaces.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <strong>Create Workspace</strong>
        </div>
        <div class="card-body">
            <form asp-action="CreateCompany" method="post" class="row g-2">
                <div class="col-md-6">
                    <input type="text" name="name" class="form-control" placeholder="Customer, building or site name" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Create Workspace</button>
                </div>
            </form>
            <div class="form-text mt-2">A workspace isolates one customer or managed site. Management users belong to a workspace; tenant users belong to a tenant inside that workspace.</div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <strong>Available Workspaces</strong>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Workspace</th>
                        <th>Status</th>
                        <th>Users</th>
                        <th>Tenants</th>
                        <th>Meters</th>
                        <th>Bills</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var company in Model.Companies)
                {
                    <tr>
                        <td>@company.CompanyId</td>
                        <td class="fw-semibold">@company.Name</td>
                        <td>
                            @if (company.Active)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Disabled</span>
                            }
                        </td>
                        <td>@company.UserCount</td>
                        <td>@company.TenantCount</td>
                        <td>@company.MeterCount</td>
                        <td>@company.BillCount</td>
                        <td>@company.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            @if (company.CompanyId == 1)
                            {
                                <span class="badge bg-dark me-2">Default</span>
                            }
                            else
                            {
                                <form asp-action="SetCompanyActive" method="post" class="d-inline">
                                    <input type="hidden" name="companyId" value="@company.CompanyId" />
                                    <input type="hidden" name="active" value="@(!company.Active)" />
                                    @if (company.Active)
                                    {
                                        <button class="btn btn-sm btn-outline-warning" type="submit"
                                                onclick="return confirm('Disable this company? Users will be blocked and automatic import will stop, but all data will be preserved.');">
                                            <i class="bi bi-pause-circle"></i> Disable
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success" type="submit">
                                            <i class="bi bi-play-circle"></i> Enable
                                        </button>
                                    }
                                </form>

                                <form asp-action="DeleteCompany" method="post" class="d-inline ms-1">
                                    <input type="hidden" name="companyId" value="@company.CompanyId" />
                                    @if (company.CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                type="submit"
                                                onclick="return confirm('Permanently delete this EMPTY company? This cannot be undone.');">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" type="button" disabled>
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                    @if (!company.CanDelete && company.CompanyId != 1)
                    {
                        <tr class="table-light">
                            <td></td>
                            <td colspan="8" class="small text-muted">
                                Permanent deletion is blocked while the company still has users, tenants, meters or bills. Disable it to archive the workspace safely.
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>