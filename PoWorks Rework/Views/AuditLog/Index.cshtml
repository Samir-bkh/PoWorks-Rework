@model PoWorks_Rework.Models.AuditLogPageViewModel
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1">Audit Logs</h2>
            <p class="text-muted mb-0">Trace administrative and configuration changes across PoWorks.</p>
        </div>
        <div class="text-end small text-muted">
            <div><strong>Offline files:</strong></div>
            <code>@Model.LogDirectory</code>
        </div>
    </div>

    <div class="alert alert-info py-2">
        Audit events are stored in PostgreSQL <strong>and</strong> written to daily JSONL files.
        General application errors are also written to daily <code>poworks-YYYY-MM-DD.log</code> files in the same directory,
        so diagnostics remain available even when the PoWorks web interface cannot be opened.
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-lg-3">
                    <label class="form-label">Search</label>
                    <input class="form-control" name="search" value="@Model.Search" placeholder="User, entity, summary..." />
                </div>
                <div class="col-lg-2">
                    <label class="form-label">Action</label>
                    <input class="form-control" name="action" value="@Model.Action" placeholder="UPDATE, DELETE..." />
                </div>
                <div class="col-lg-2">
                    <label class="form-label">Entity</label>
                    <input class="form-control" name="entityType" value="@Model.EntityType" placeholder="User, Workspace..." />
                </div>
                <div class="col-lg-1">
                    <label class="form-label">Workspace</label>
                    <input class="form-control" type="number" name="companyId" value="@Model.CompanyId" min="1" />
                </div>
                <div class="col-lg-2">
                    <label class="form-label">From</label>
                    <input class="form-control" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-lg-2">
                    <label class="form-label">To</label>
                    <input class="form-control" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12">
                    <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between">
            <strong>@Model.TotalCount event(s)</strong>
            <span class="text-muted">Page @Model.Page / @Model.TotalPages</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="min-width:165px">Time (UTC)</th>
                        <th>User</th>
                        <th>Workspace</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Summary</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No audit event matches the selected filters.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><small>@item.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</small></td>
                            <td>
                                <div>@(item.UserName ?? "System")</div>
                                @if (!string.IsNullOrWhiteSpace(item.UserType))
                                {
                                    <small class="text-muted">@item.UserType</small>
                                }
                            </td>
                            <td>@(item.CompanyId?.ToString() ?? "—")</td>
                            <td><span class="badge bg-secondary">@item.Action</span></td>
                            <td>
                                <div>@item.EntityType</div>
                                @if (!string.IsNullOrWhiteSpace(item.EntityId))
                                {
                                    <small class="text-muted">#@item.EntityId</small>
                                }
                            </td>
                            <td style="min-width:260px">@item.Summary</td>
                            <td>
                                @if (item.Success)
                                {
                                    <span class="badge bg-success">Success</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Failed</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.BeforeJson) || !string.IsNullOrWhiteSpace(item.AfterJson))
                                {
                                    <button class="btn btn-sm btn-outline-secondary" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#audit-@item.AuditLogId">
                                        Details
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(item.BeforeJson) || !string.IsNullOrWhiteSpace(item.AfterJson))
                        {
                            <tr class="collapse" id="audit-@item.AuditLogId">
                                <td colspan="8" class="bg-light">
                                    <div class="row g-3">
                                        <div class="col-lg-6">
                                            <strong>Before</strong>
                                            <pre class="small mt-2 mb-0 text-wrap">@(!string.IsNullOrWhiteSpace(item.BeforeJson) ? item.BeforeJson : "—")</pre>
                                        </div>
                                        <div class="col-lg-6">
                                            <strong>After</strong>
                                            <pre class="small mt-2 mb-0 text-wrap">@(!string.IsNullOrWhiteSpace(item.AfterJson) ? item.AfterJson : "—")</pre>
                                        </div>
                                        <div class="col-12 small text-muted">
                                            IP: @(item.IpAddress ?? "—") · Correlation: @(item.CorrelationId ?? "—")
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between">
                <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-action="@Model.Action"
                   asp-route-entityType="@Model.EntityType"
                   asp-route-companyId="@Model.CompanyId"
                   asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                   asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                   asp-route-page="@(Model.Page - 1)">Previous</a>

                <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-action="@Model.Action"
                   asp-route-entityType="@Model.EntityType"
                   asp-route-companyId="@Model.CompanyId"
                   asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                   asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                   asp-route-page="@(Model.Page + 1)">Next</a>
            </div>
        }
    </div>
</div>
