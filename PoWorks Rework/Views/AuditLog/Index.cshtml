@model PoWorks_Rework.Models.AuditLogPageViewModel
@{
    ViewData["Title"] = "Audit Logs";
}

<style>
    .audit-table {
        font-size: .875rem;
    }

    .audit-table > :not(caption) > * > * {
        padding-top: .38rem;
        padding-bottom: .38rem;
        vertical-align: middle;
    }

    .audit-summary {
        max-width: 430px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .audit-storage summary {
        cursor: pointer;
        user-select: none;
    }

    .audit-filter-label {
        font-size: .75rem;
        color: var(--bs-secondary-color);
        margin-bottom: .2rem;
    }

    .audit-details pre {
        max-height: 240px;
        overflow: auto;
        white-space: pre-wrap;
        word-break: break-word;
    }
</style>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="mb-0">Audit Logs</h3>
            <div class="text-muted small">Administrative and configuration history across PoWorks.</div>
        </div>
        <details class="audit-storage small text-muted">
            <summary>Offline log files</summary>
            <div class="mt-1 text-end">
                <code>@Model.LogDirectory</code>
                <div>JSONL audit trail + daily diagnostic files.</div>
            </div>
        </details>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-xl-4 col-md-6">
                    <label class="audit-filter-label">Search</label>
                    <input class="form-control form-control-sm" name="search" value="@Model.Search" placeholder="User, entity, summary..." />
                </div>
                <div class="col-xl-2 col-md-3">
                    <label class="audit-filter-label">Action</label>
                    <input class="form-control form-control-sm" name="auditAction" value="@Model.Action" placeholder="UPDATE, DELETE..." />
                </div>
                <div class="col-xl-2 col-md-3">
                    <label class="audit-filter-label">Entity</label>
                    <input class="form-control form-control-sm" name="entityType" value="@Model.EntityType" placeholder="User, Workspace..." />
                </div>
                <div class="col-xl-1 col-md-2">
                    <label class="audit-filter-label">Workspace</label>
                    <input class="form-control form-control-sm" type="number" name="companyId" value="@Model.CompanyId" min="1" />
                </div>
                <div class="col-xl-1 col-md-2">
                    <label class="audit-filter-label">Rows</label>
                    <select class="form-select form-select-sm" name="pageSize">
                        <option value="15" selected="@(Model.PageSize == 15)">15</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    </select>
                </div>
                <div class="col-xl-1 col-md-2">
                    <label class="audit-filter-label">From</label>
                    <input class="form-control form-control-sm" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-xl-1 col-md-2">
                    <label class="audit-filter-label">To</label>
                    <input class="form-control form-control-sm" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-xl-5 col-md-7 d-flex align-items-center">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="showTechnical" name="showTechnical" value="true"
                               checked="@(Model.ShowTechnical ? "checked" : null)" />
                        <label class="form-check-label small" for="showTechnical">
                            Show technical request events
                        </label>
                    </div>
                </div>
                <div class="col-xl-7 col-md-5 text-md-end">
                    <button class="btn btn-sm btn-primary" type="submit">
                        <i class="bi bi-funnel"></i> Apply
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <strong>@Model.TotalCount event(s)</strong>
                @if (!Model.ShowTechnical)
                {
                    <span class="badge text-bg-light border">Technical MUTATION events hidden</span>
                }
            </div>
            <span class="text-muted small">Page @Model.Page / @Model.TotalPages</span>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover audit-table mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="min-width:125px">Time (local)</th>
                        <th style="min-width:125px">User</th>
                        <th style="min-width:105px">Action</th>
                        <th style="min-width:145px">Entity</th>
                        <th class="text-center">WS</th>
                        <th>Summary</th>
                        <th style="min-width:80px">Status</th>
                        <th style="width:1%"></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No audit event matches the selected filters.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        var hasGuidEntityId = Guid.TryParse(item.EntityId, out _);
                        var hasTechnicalDetails =
                            !string.IsNullOrWhiteSpace(item.EntityId) ||
                            !string.IsNullOrWhiteSpace(item.BeforeJson) ||
                            !string.IsNullOrWhiteSpace(item.AfterJson) ||
                            !string.IsNullOrWhiteSpace(item.IpAddress) ||
                            !string.IsNullOrWhiteSpace(item.CorrelationId);

                        var badgeClass = item.Action.ToUpperInvariant() switch
                        {
                            "CREATE" => "bg-success",
                            "UPDATE" => "bg-primary",
                            "DELETE" => "bg-danger",
                            "DELETE_BLOCKED" => "bg-warning text-dark",
                            "ENABLE" => "bg-success",
                            "DISABLE" => "bg-secondary",
                            "LOGIN" => "bg-info text-dark",
                            "LOGOUT" => "bg-secondary",
                            "MUTATION_FAILED" => "bg-danger",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td>
                                <span class="audit-local-time text-nowrap"
                                      data-utc="@item.TimestampUtc.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ss.fffZ")"
                                      title="UTC: @item.TimestampUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")">
                                    @item.TimestampUtc.ToLocalTime().ToString("dd/MM HH:mm:ss")
                                </span>
                            </td>
                            <td class="text-nowrap">
                                @(item.UserName ?? "System")
                                @if (!string.IsNullOrWhiteSpace(item.UserType))
                                {
                                    <span class="text-muted small">(@item.UserType)</span>
                                }
                            </td>
                            <td><span class="badge @badgeClass">@item.Action</span></td>
                            <td class="text-nowrap">
                                @item.EntityType
                                @if (!string.IsNullOrWhiteSpace(item.EntityId) && !hasGuidEntityId)
                                {
                                    <span class="text-muted small">#@item.EntityId</span>
                                }
                            </td>
                            <td class="text-center">@(item.CompanyId?.ToString() ?? "—")</td>
                            <td>
                                <div class="audit-summary" title="@item.Summary">@item.Summary</div>
                            </td>
                            <td>
                                @if (item.Success)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">OK</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Failed</span>
                                }
                            </td>
                            <td>
                                @if (hasTechnicalDetails)
                                {
                                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#audit-@item.AuditLogId"
                                            title="Show details">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                }
                            </td>
                        </tr>

                        @if (hasTechnicalDetails)
                        {
                            <tr class="collapse audit-details" id="audit-@item.AuditLogId">
                                <td colspan="8" class="bg-light py-2">
                                    <div class="row g-2">
                                        @if (!string.IsNullOrWhiteSpace(item.BeforeJson) || !string.IsNullOrWhiteSpace(item.AfterJson))
                                        {
                                            <div class="col-lg-6">
                                                <strong class="small">Before</strong>
                                                <pre class="small mt-1 mb-0 border rounded bg-white p-2">@(!string.IsNullOrWhiteSpace(item.BeforeJson) ? item.BeforeJson : "—")</pre>
                                            </div>
                                            <div class="col-lg-6">
                                                <strong class="small">After</strong>
                                                <pre class="small mt-1 mb-0 border rounded bg-white p-2">@(!string.IsNullOrWhiteSpace(item.AfterJson) ? item.AfterJson : "—")</pre>
                                            </div>
                                        }
                                        <div class="col-12 small text-muted">
                                            @if (!string.IsNullOrWhiteSpace(item.EntityId))
                                            {
                                                <span>Technical ID: @item.EntityId · </span>
                                            }
                                            IP: @(item.IpAddress ?? "—") ·
                                            Correlation: @(item.CorrelationId ?? "—") ·
                                            UTC: @item.TimestampUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white py-2 d-flex justify-content-between align-items-center">
            <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")"
               asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-auditAction="@Model.Action"
               asp-route-entityType="@Model.EntityType"
               asp-route-companyId="@Model.CompanyId"
               asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
               asp-route-showTechnical="@Model.ShowTechnical"
               asp-route-pageSize="@Model.PageSize"
               asp-route-page="@(Model.Page - 1)">Previous</a>

            <span class="small text-muted">@Model.Page / @Model.TotalPages</span>

            <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")"
               asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-auditAction="@Model.Action"
               asp-route-entityType="@Model.EntityType"
               asp-route-companyId="@Model.CompanyId"
               asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
               asp-route-showTechnical="@Model.ShowTechnical"
               asp-route-pageSize="@Model.PageSize"
               asp-route-page="@(Model.Page + 1)">Next</a>
        </div>
    </div>
</div>

<script>
    (() => {
        const pad = value => String(value).padStart(2, '0');

        document.querySelectorAll('.audit-local-time[data-utc]').forEach(element => {
            const utcValue = element.getAttribute('data-utc');
            const date = new Date(utcValue);

            if (Number.isNaN(date.getTime())) {
                return;
            }

            element.textContent =
                pad(date.getDate()) + '/' +
                pad(date.getMonth() + 1) + ' ' +
                pad(date.getHours()) + ':' +
                pad(date.getMinutes()) + ':' +
                pad(date.getSeconds());

            element.title =
                'Local: ' +
                date.getFullYear() + '-' +
                pad(date.getMonth() + 1) + '-' +
                pad(date.getDate()) + ' ' +
                pad(date.getHours()) + ':' +
                pad(date.getMinutes()) + ':' +
                pad(date.getSeconds()) +
                ' · ' + element.title;
        });
    })();
</script>
