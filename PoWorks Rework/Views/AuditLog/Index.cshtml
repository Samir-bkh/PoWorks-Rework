@model PoWorks_Rework.Models.AuditLogPageViewModel
@{
    ViewData["Title"] = "Audit Logs";
}

<style>
    .audit-table-wrap {
        max-height: 62vh;
        overflow: auto;
    }

    .audit-table-wrap thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--bs-light);
        box-shadow: inset 0 -1px 0 rgba(0,0,0,.08);
    }

    .audit-summary {
        max-width: 520px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .audit-meta {
        font-size: .78rem;
        color: var(--bs-secondary-color);
    }

    .audit-detail-pre {
        max-height: 260px;
        overflow: auto;
        white-space: pre-wrap;
        word-break: break-word;
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: .375rem;
        padding: .75rem;
    }
</style>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="mb-1">Audit Logs</h3>
            <p class="text-muted mb-0">Important administrative and configuration events.</p>
        </div>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#auditStorageInfo">
            <i class="bi bi-hdd"></i> Storage info
        </button>
    </div>

    <div class="collapse mb-3" id="auditStorageInfo">
        <div class="alert alert-light border py-2 mb-0 small">
            Audit events are stored in PostgreSQL and daily JSONL files. General diagnostics are kept in
            <code>poworks-YYYY-MM-DD.log</code> under <code>@Model.LogDirectory</code>.
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-xl-3 col-md-6">
                    <label class="form-label small mb-1">Search</label>
                    <input class="form-control form-control-sm" name="search" value="@Model.Search" placeholder="User, entity, summary..." />
                </div>
                <div class="col-xl-2 col-md-3">
                    <label class="form-label small mb-1">Action</label>
                    <input class="form-control form-control-sm" name="auditAction" value="@Model.Action" placeholder="UPDATE, DELETE..." />
                </div>
                <div class="col-xl-2 col-md-3">
                    <label class="form-label small mb-1">Entity</label>
                    <input class="form-control form-control-sm" name="entityType" value="@Model.EntityType" placeholder="Tenant, User..." />
                </div>
                <div class="col-xl-1 col-md-3">
                    <label class="form-label small mb-1">Workspace</label>
                    <input class="form-control form-control-sm" type="number" name="companyId" value="@Model.CompanyId" min="1" />
                </div>
                <div class="col-xl-2 col-md-3">
                    <label class="form-label small mb-1">From</label>
                    <input class="form-control form-control-sm" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-xl-2 col-md-3">
                    <label class="form-label small mb-1">To</label>
                    <input class="form-control form-control-sm" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-xl-7 col-md-9 d-flex flex-wrap align-items-center gap-2 pt-1">
                    <button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-search"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
                    <div class="form-check ms-xl-2">
                        <input class="form-check-input" type="checkbox" name="showTechnical" value="true" id="showTechnical" @(Model.ShowTechnical ? "checked" : "") />
                        <label class="form-check-label small" for="showTechnical">
                            Show technical MUTATION events
                        </label>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <strong>@Model.TotalCount event(s)</strong>
                @if (!Model.ShowTechnical && string.IsNullOrWhiteSpace(Model.Action))
                {
                    <span class="badge text-bg-light border ms-2">Technical duplicates hidden</span>
                }
            </div>
            <span class="text-muted small">Page @Model.Page / @Model.TotalPages · @Model.PageSize per page</span>
        </div>

        <div class="table-responsive audit-table-wrap">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="min-width:145px">Time</th>
                        <th style="min-width:110px">User</th>
                        <th class="text-center">WS</th>
                        <th>Action</th>
                        <th style="min-width:130px">Entity</th>
                        <th style="min-width:320px">Summary</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No audit event matches the selected filters.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        var hasGuidEntityId = Guid.TryParse(item.EntityId, out _);
                        var hasTechnicalDetails =
                            !string.IsNullOrWhiteSpace(item.EntityId) ||
                            !string.IsNullOrWhiteSpace(item.BeforeJson) ||
                            !string.IsNullOrWhiteSpace(item.AfterJson) ||
                            !string.IsNullOrWhiteSpace(item.IpAddress) ||
                            !string.IsNullOrWhiteSpace(item.CorrelationId);

                        var actionClass = item.Action switch
                        {
                            "CREATE" => "text-bg-primary",
                            "UPDATE" => "text-bg-info",
                            "DELETE" => "text-bg-danger",
                            "DELETE_BLOCKED" => "text-bg-warning",
                            "ENABLE" => "text-bg-success",
                            "DISABLE" => "text-bg-warning",
                            "LOGIN" => "text-bg-success",
                            "LOGOUT" => "text-bg-secondary",
                            _ => "text-bg-secondary"
                        };

                        <tr>
                            <td>
                                <span class="audit-local-time small"
                                      data-utc="@item.TimestampUtc.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ss.fffZ")"
                                      title="UTC: @item.TimestampUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")">
                                    @item.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                </span>
                            </td>
                            <td>
                                <div class="small fw-semibold">@(item.UserName ?? "System")</div>
                                @if (!string.IsNullOrWhiteSpace(item.UserType) && !string.Equals(item.UserType, item.UserName, StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="audit-meta">@item.UserType</div>
                                }
                            </td>
                            <td class="text-center small">@(item.CompanyId?.ToString() ?? "—")</td>
                            <td><span class="badge @actionClass">@item.Action</span></td>
                            <td>
                                <div class="small fw-semibold">@item.EntityType</div>
                                @if (!string.IsNullOrWhiteSpace(item.EntityId) && !hasGuidEntityId)
                                {
                                    <div class="audit-meta">#@item.EntityId</div>
                                }
                            </td>
                            <td>
                                <div class="audit-summary small" title="@item.Summary">@item.Summary</div>
                            </td>
                            <td>
                                @if (item.Success)
                                {
                                    <span class="badge text-bg-success">OK</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Failed</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (hasTechnicalDetails)
                                {
                                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#audit-@item.AuditLogId"
                                            aria-label="Show audit details">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                }
                            </td>
                        </tr>

                        @if (hasTechnicalDetails)
                        {
                            <tr class="collapse" id="audit-@item.AuditLogId">
                                <td colspan="8" class="bg-light p-3">
                                    <div class="row g-3">
                                        @if (!string.IsNullOrWhiteSpace(item.BeforeJson) || !string.IsNullOrWhiteSpace(item.AfterJson))
                                        {
                                            <div class="col-lg-6">
                                                <strong class="small">Before</strong>
                                                <pre class="audit-detail-pre small mt-1 mb-0">@(!string.IsNullOrWhiteSpace(item.BeforeJson) ? item.BeforeJson : "—")</pre>
                                            </div>
                                            <div class="col-lg-6">
                                                <strong class="small">After</strong>
                                                <pre class="audit-detail-pre small mt-1 mb-0">@(!string.IsNullOrWhiteSpace(item.AfterJson) ? item.AfterJson : "—")</pre>
                                            </div>
                                        }
                                        <div class="col-12 audit-meta">
                                            @if (!string.IsNullOrWhiteSpace(item.EntityId))
                                            {
                                                <span>Technical ID: @item.EntityId · </span>
                                            }
                                            IP: @(item.IpAddress ?? "—") · Correlation: @(item.CorrelationId ?? "—") · UTC: @item.TimestampUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white py-2 d-flex justify-content-between align-items-center">
            <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")"
               asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-auditAction="@Model.Action"
               asp-route-entityType="@Model.EntityType"
               asp-route-companyId="@Model.CompanyId"
               asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
               asp-route-showTechnical="@Model.ShowTechnical"
               asp-route-page="@(Model.Page - 1)">Previous</a>

            <span class="small text-muted">@Model.Page / @Model.TotalPages</span>

            <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")"
               asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-auditAction="@Model.Action"
               asp-route-entityType="@Model.EntityType"
               asp-route-companyId="@Model.CompanyId"
               asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
               asp-route-showTechnical="@Model.ShowTechnical"
               asp-route-page="@(Model.Page + 1)">Next</a>
        </div>
    </div>
</div>

<script>
    (() => {
        const pad = value => String(value).padStart(2, '0');

        document.querySelectorAll('.audit-local-time[data-utc]').forEach(element => {
            const utcValue = element.getAttribute('data-utc');
            const date = new Date(utcValue);

            if (Number.isNaN(date.getTime())) {
                return;
            }

            element.textContent =
                date.getFullYear() + '-' +
                pad(date.getMonth() + 1) + '-' +
                pad(date.getDate()) + ' ' +
                pad(date.getHours()) + ':' +
                pad(date.getMinutes()) + ':' +
                pad(date.getSeconds());
        });
    })();
</script>
