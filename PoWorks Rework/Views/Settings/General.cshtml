    /**
     * Adds a new Web Service connection dynamically.
     */
    function addNewWebServiceConnection() {
        webServiceConnectionCounter++;
        const newConnectionId = generateGuid();

        const tabsContainer = document.getElementById('webServiceConnectionTabs');
        const newTabHtml = `
            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        id="webservice-${newConnectionId}-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#webservice-${newConnectionId}"
                        type="button"
                        role="tab"
                        aria-controls="webservice-${newConnectionId}"
                        aria-selected="false"
                        data-connection-id="${newConnectionId}">
                    New Web Service Connection
                    <button type="button" class="btn-close btn-close-sm ms-2" aria-label="Close"
                            onclick="removeWebServiceConnection('${newConnectionId}')"
                            style="font-size: 0.6em; margin-left: 8px !important;"></button>
                </button>
            </li>`;

        tabsContainer.insertAdjacentHTML('beforeend', newTabHtml);

        const contentContainer = document.getElementById('webServiceConnectionContent');
        const newContentHtml = createWebServiceConnectionFormHtml(newConnectionId);
        contentContainer.insertAdjacentHTML('beforeend', newContentHtml);

        const newTab = document.getElementById(`webservice-${newConnectionId}-tab`);
        const newTabInstance = new bootstrap.Tab(newTab);
        newTabInstance.show();
    }

