    /**
     * Removes an existing SQL Server connection from UI and sends delete request to backend.
     */
    window.removeConnection = function(connectionId) {
        const connectionTabs = document.querySelectorAll('#sqlServerConnectionTabs .nav-item');
        if (connectionTabs.length <= 1) {
            alert('Cannot remove the last connection. At least one connection is required.');
            return;
        }

        const tabButton = document.getElementById(`sqlconn-${connectionId}-tab`);
        const connectionName = tabButton ? tabButton.textContent.replace('×', '').trim() : 'this connection';

        if (confirm(`Are you sure you want to delete "${connectionName}"? This action cannot be undone.`)) {
            fetch('/Settings/DeleteSqlServerConnection', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ConnectionId: connectionId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const tabElement = document.getElementById(`sqlconn-${connectionId}-tab`);
                    const contentElement = document.getElementById(`sqlconn-${connectionId}`);

                    if (tabElement) tabElement.closest('.nav-item').remove();
                    if (contentElement) contentElement.remove();

                    const remainingTabs = document.querySelectorAll('#sqlServerConnectionTabs .nav-link');
                    if (remainingTabs.length > 0 && !document.querySelector('#sqlServerConnectionTabs .nav-link.active')) {
                        const firstTab = remainingTabs[0];
                        const tabInstance = new bootstrap.Tab(firstTab);
                        tabInstance.show();

                        if (data.newDefaultConnectionId) {
                            updateDefaultBadge(data.newDefaultConnectionId, 'sqlconn');
                        }
                    }
                    showMessage('Connection deleted successfully!', 'success');
                } else {
                    showMessage('Error deleting connection: ' + data.error, 'danger');
                }
            })
            .catch(error => {
                console.error('Error deleting connection:', error);
                showMessage('Error deleting connection: ' + error.message, 'danger');
            });
        }
    };

    /**
     * Sends an AJAX request to test SQL Server connectivity.
     */
    window.testConnection = function(connectionId) {
        const form = document.querySelector(`#sqlconn-${connectionId} form`);
        if (!form) return;

        const formData = new FormData(form);
        const connectionData = {
            connectionId: connectionId,
            host: formData.get('Host') || '',
            port: formData.get('Port') || '1433',
            database: formData.get('Database') || '',
            username: formData.get('Username') || '',
            password: formData.get('Password') || '',
            projectName: formData.get('ProjectName') || '',
            connectionName: formData.get('ConnectionName') || ''
        };

        if (!connectionData.host || !connectionData.database || !connectionData.username) {
            showConnectionResult(connectionId, 'warning', 'Please fill in all required fields (Host, Database, Username)');
            return;
        }

        showConnectionResult(connectionId, 'info', 'Testing connection...');

        fetch('/Settings/TestSqlServerConnection', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(connectionData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showConnectionResult(connectionId, 'success', 'Connection successful! ✓');
            } else {
                showConnectionResult(connectionId, 'danger', `Connection failed: ${data.errorMessage || 'Unknown error'}`);
            }
        })
        .catch(error => {
            showConnectionResult(connectionId, 'danger', `Error testing connection: ${error.message}`);
        });
    };

    function showConnectionResult(connectionId, alertType, message) {
        const resultElement = document.getElementById(`connectionResult-${connectionId}`);
        if (resultElement) {
            resultElement.style.display = 'block';
            resultElement.className = `alert alert-${alertType} mt-3`;
            resultElement.textContent = message;

            if (alertType === 'success') {
                setTimeout(() => { resultElement.style.display = 'none'; }, 5000);
            }
        }
    }

    /**
     * Saves all SQL Server connections via single POST request.
     */
    document.getElementById('saveAllSqlConnections').addEventListener('click', function() {
        const forms = document.querySelectorAll('.sql-connection-form');
        const connections = [];

        forms.forEach(form => {
            const formData = new FormData(form);
            connections.push(Object.fromEntries(formData.entries()));
        });

        fetch('/Settings/SaveSqlServerConnections', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ connections: connections })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('SQL Server connections saved successfully!');
                location.reload();
            } else {
                alert('Error saving connections: ' + data.error);
            }
        })
        .catch(error => { alert('Error saving connections: ' + error); });
    });

    // =========================================================================
