@model PoWorks_Rework.Models.MeterManagementViewModel
@{
    ViewData["Title"] = "Meter Management";
    var selected = Model.SelectedMeter;
}

<style>
    .meter-summary-card {
        min-height: 88px;
    }

    .meter-table-wrap {
        max-height: 58vh;
        overflow: auto;
        background: #ffffff;
    }

    .meter-table-wrap table {
        border-collapse: separate;
        border-spacing: 0;
    }

    .meter-table-wrap thead th {
        position: sticky;
        top: 0;
        z-index: 20;
        height: 44px;
        padding: .65rem .5rem;
        vertical-align: middle;
        white-space: nowrap;
        background: #f8f9fa !important;
        color: #212529 !important;
        font-weight: 700;
        border-bottom: 1px solid #cfd4da !important;
        box-shadow: 0 2px 4px rgba(33, 37, 41, .08);
    }

    .meter-table-wrap tbody td {
        position: relative;
        z-index: 0;
        vertical-align: middle;
        background-clip: padding-box;
    }

    .meter-table-wrap tbody tr.table-primary > td {
        background-color: #dbeafe !important;
        color: #212529 !important;
    }

    .meter-name {
        max-width: 290px;
    }

    .meter-name .technical {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .meter-type-badge {
        display: inline-flex;
        align-items: center;
        min-width: 52px;
        justify-content: center;
        background: #e9ecef !important;
        color: #212529 !important;
        border: 1px solid #ced4da !important;
        font-weight: 600;
    }

    .meter-status-active {
        background: #d1e7dd !important;
        color: #0f5132 !important;
        border: 1px solid #a3cfbb !important;
        font-weight: 600;
    }

    .meter-status-disabled {
        background: #e2e3e5 !important;
        color: #41464b !important;
        border: 1px solid #c4c8cb !important;
        font-weight: 600;
    }

    .meter-bulk-bar {
        position: sticky;
        bottom: 0;
        z-index: 10;
        background: #ffffff !important;
        color: #212529 !important;
        border-top: 1px solid #dee2e6 !important;
        box-shadow: 0 -4px 14px rgba(33, 37, 41, .10);
        padding: .75rem 1rem !important;
    }

    .meter-bulk-label {
        color: #495057;
        font-weight: 600;
    }

    .meter-selection-badge {
        background: #e7f1ff !important;
        color: #084298 !important;
        border: 1px solid #b6d4fe !important;
        font-weight: 700;
    }

    .meter-bulk-actions .btn {
        min-width: 118px;
        background-color: #ffffff;
    }
</style>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="mb-1">Meter Management</h3>
            <p class="text-muted mb-0">Configure meters, tenant assignments and lifecycle within the current workspace.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Meter" asp-action="Readings" class="btn btn-outline-secondary">
                <i class="bi bi-graph-up"></i> Meter Readings
            </a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newMeterModal">
                <i class="bi bi-plus-lg"></i> New Meter
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm meter-summary-card h-100">
                <div class="card-body py-3">
                    <div class="small text-muted">Total meters</div>
                    <div class="fs-4 fw-semibold">@Model.Summary.Total</div>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-6">
            <a class="text-decoration-none text-body"
               asp-action="Management"
               asp-route-statusFilter="Active">
                <div class="card shadow-sm meter-summary-card h-100">
                    <div class="card-body py-3">
                        <div class="small text-muted">Active</div>
                        <div class="fs-4 fw-semibold text-success">@Model.Summary.Active</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl col-md-4 col-6">
            <a class="text-decoration-none text-body"
               asp-action="Management"
               asp-route-statusFilter="Disabled">
                <div class="card shadow-sm meter-summary-card h-100">
                    <div class="card-body py-3">
                        <div class="small text-muted">Disabled</div>
                        <div class="fs-4 fw-semibold">@Model.Summary.Disabled</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl col-md-6 col-6">
            <a class="text-decoration-none text-body"
               asp-action="Management"
               asp-route-assignmentFilter="Assigned">
                <div class="card shadow-sm meter-summary-card h-100">
                    <div class="card-body py-3">
                        <div class="small text-muted">Assigned</div>
                        <div class="fs-4 fw-semibold">@Model.Summary.Assigned</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl col-md-6 col-6">
            <a class="text-decoration-none text-body"
               asp-action="Management"
               asp-route-assignmentFilter="Unassigned">
                <div class="card shadow-sm meter-summary-card h-100">
                    <div class="card-body py-3">
                        <div class="small text-muted">Unassigned</div>
                        <div class="fs-4 fw-semibold text-warning">@Model.Summary.Unassigned</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-3">
            <form asp-action="Management" method="get" class="row g-2 align-items-end">
                <div class="col-xl-2 col-md-4">
                    <label class="form-label small mb-1" for="searchField">Search by</label>
                    <select class="form-select form-select-sm" id="searchField" name="searchField">
                        <option value="Name" selected="@(Model.SearchCriteria.SearchField == "Name")">Name / label</option>
                        <option value="Type" selected="@(Model.SearchCriteria.SearchField == "Type")">Type</option>
                        <option value="Tenant" selected="@(Model.SearchCriteria.SearchField == "Tenant")">Tenant</option>
                    </select>
                </div>
                <div class="col-xl-4 col-md-8">
                    <label class="form-label small mb-1" for="searchTerm">Search</label>
                    <input class="form-control form-control-sm"
                           id="searchTerm"
                           name="searchTerm"
                           value="@Model.SearchCriteria.SearchTerm"
                           placeholder="Meter, label, type or tenant..." />
                </div>
                <div class="col-xl-2 col-md-4">
                    <label class="form-label small mb-1" for="statusFilter">Status</label>
                    <select class="form-select form-select-sm" id="statusFilter" name="statusFilter">
                        <option value="All" selected="@(Model.SearchCriteria.StatusFilter == "All")">All</option>
                        <option value="Active" selected="@(Model.SearchCriteria.StatusFilter == "Active")">Active</option>
                        <option value="Disabled" selected="@(Model.SearchCriteria.StatusFilter == "Disabled")">Disabled</option>
                    </select>
                </div>
                <div class="col-xl-2 col-md-4">
                    <label class="form-label small mb-1" for="assignmentFilter">Tenant assignment</label>
                    <select class="form-select form-select-sm" id="assignmentFilter" name="assignmentFilter">
                        <option value="All" selected="@(Model.SearchCriteria.AssignmentFilter == "All")">All</option>
                        <option value="Assigned" selected="@(Model.SearchCriteria.AssignmentFilter == "Assigned")">Assigned</option>
                        <option value="Unassigned" selected="@(Model.SearchCriteria.AssignmentFilter == "Unassigned")">Unassigned</option>
                    </select>
                </div>
                <div class="col-xl-2 col-md-4 d-flex gap-2">
                    <button class="btn btn-sm btn-primary flex-fill" type="submit">
                        <i class="bi bi-search"></i> Filter
                    </button>
                    <a asp-action="Management" class="btn btn-sm btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <strong>@Model.TotalItems meter(s)</strong>
                @if (Model.SearchCriteria.StatusFilter != "All" || Model.SearchCriteria.AssignmentFilter != "All" || !string.IsNullOrWhiteSpace(Model.SearchCriteria.SearchTerm))
                {
                    <span class="badge text-bg-light border ms-2">Filtered</span>
                }
            </div>
            <span class="text-muted small">Page @Model.CurrentPage / @Model.TotalPages · @Model.PageSize per page</span>
        </div>

        <div class="table-responsive meter-table-wrap">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width:42px">
                            <input class="form-check-input" type="checkbox" id="selectAllMeters" aria-label="Select visible meters" />
                        </th>
                        <th style="min-width:260px">Meter</th>
                        <th style="min-width:125px">Type / Parent</th>
                        <th style="min-width:90px">Unit</th>
                        <th style="min-width:180px">Tenant</th>
                        <th style="min-width:105px">Status</th>
                        <th style="min-width:120px">Last reading</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr id="selectAllBannerRow" class="d-none">
                        <td colspan="8" class="text-center bg-primary-subtle py-2">
                            <span id="bannerVisible">
                                All <strong><span id="visibleSelectionCount">0</span></strong> visible meters are selected.
                                <button class="btn btn-link btn-sm p-0 ms-2" type="button" onclick="selectAllAcrossPages()">
                                    Select all @Model.TotalItems filtered meter(s)
                                </button>
                            </span>
                            <span id="bannerAll" class="d-none">
                                <i class="bi bi-check-circle-fill"></i>
                                All @Model.TotalItems filtered meter(s) are selected.
                                <button class="btn btn-link btn-sm text-danger p-0 ms-2" type="button" onclick="clearAllAcrossPages()">
                                    Clear
                                </button>
                            </span>
                        </td>
                    </tr>

                    @if (Model.SearchResults.Any())
                    {
                        @foreach (var meter in Model.SearchResults)
                        {
                            <tr class="@(selected?.Id == meter.Id ? "table-primary" : "")">
                                <td class="text-center">
                                    <input class="form-check-input meter-checkbox" type="checkbox" value="@meter.Id" />
                                </td>
                                <td class="meter-name">
                                    <a class="fw-semibold text-decoration-none"
                                       asp-action="Management"
                                       asp-route-id="@meter.Id"
                                       asp-route-searchField="@Model.SearchCriteria.SearchField"
                                       asp-route-searchTerm="@Model.SearchCriteria.SearchTerm"
                                       asp-route-statusFilter="@Model.SearchCriteria.StatusFilter"
                                       asp-route-assignmentFilter="@Model.SearchCriteria.AssignmentFilter"
                                       asp-route-page="@Model.CurrentPage">
                                        @(string.IsNullOrWhiteSpace(meter.Label) ? meter.Name : meter.Label)
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(meter.Label))
                                    {
                                        <div class="small text-muted technical" title="@meter.Name">@meter.Name</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge rounded-pill meter-type-badge">@meter.Type</span>
                                    @if (!string.IsNullOrWhiteSpace(meter.ParentMeterName))
                                    {
                                        <div class="small text-muted mt-1">@meter.ParentMeterName</div>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(meter.Unit) ? "—" : meter.Unit)</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(meter.TenantName))
                                    {
                                        <span class="text-muted">Unassigned</span>
                                    }
                                    else
                                    {
                                        <span>@meter.TenantName</span>
                                    }
                                </td>
                                <td>
                                    @if (meter.Active)
                                    {
                                        <span class="badge rounded-pill meter-status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill meter-status-disabled">Disabled</span>
                                    }
                                </td>
                                <td>@meter.LastReading</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary py-0 px-2"
                                       asp-action="Management"
                                       asp-route-id="@meter.Id"
                                       asp-route-searchField="@Model.SearchCriteria.SearchField"
                                       asp-route-searchTerm="@Model.SearchCriteria.SearchTerm"
                                       asp-route-statusFilter="@Model.SearchCriteria.StatusFilter"
                                       asp-route-assignmentFilter="@Model.SearchCriteria.AssignmentFilter"
                                       asp-route-page="@Model.CurrentPage"
                                       asp-route-pageSize="@Model.PageSize">
                                        Open
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No meters match the current filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="bulkActionBar" class="meter-bulk-bar d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="meter-bulk-label"><i class="bi bi-check2-square me-1"></i>Actions for selected meters</span>
                    <span class="badge rounded-pill meter-selection-badge"><span id="selectedCount">0</span> selected</span>
                    <span id="allMatchingLabel" class="small text-muted d-none">across all filtered pages</span>
                </div>
                <div class="d-flex flex-wrap gap-2 meter-bulk-actions">
                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#bulkEditModal">
                        <i class="bi bi-pencil-square"></i> Edit selected
                    </button>
                    <button class="btn btn-sm btn-outline-primary" type="button" onclick="quickAssignSelected()">
                        <i class="bi bi-person-check"></i> Assign selected
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" onclick="unassignBulkTenant()">
                        <i class="bi bi-person-x"></i> Unassign selected
                    </button>
                    <button class="btn btn-sm btn-outline-success" type="button" onclick="setBulkMetersActive(true)">
                        <i class="bi bi-play-circle"></i> Enable selected
                    </button>
                    <button class="btn btn-sm btn-outline-warning text-dark" type="button" onclick="setBulkMetersActive(false)">
                        <i class="bi bi-pause-circle"></i> Disable selected
                    </button>
                    <button class="btn btn-sm btn-outline-danger" type="button" onclick="deleteBulkMeters()">
                        <i class="bi bi-trash"></i> Delete selected
                    </button>
                </div>
            </div>
        </div>

        <div class="card-footer bg-white py-2 d-flex justify-content-between align-items-center">
            <a class="btn btn-sm btn-outline-secondary @(Model.CurrentPage <= 1 ? "disabled" : "")"
               asp-action="Management"
               asp-route-searchField="@Model.SearchCriteria.SearchField"
               asp-route-searchTerm="@Model.SearchCriteria.SearchTerm"
               asp-route-statusFilter="@Model.SearchCriteria.StatusFilter"
               asp-route-assignmentFilter="@Model.SearchCriteria.AssignmentFilter"
               asp-route-page="@(Model.CurrentPage - 1)"
               asp-route-pageSize="@Model.PageSize">Previous</a>

            <span class="small text-muted">@Model.CurrentPage / @Model.TotalPages</span>

            <a class="btn btn-sm btn-outline-secondary @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
               asp-action="Management"
               asp-route-searchField="@Model.SearchCriteria.SearchField"
               asp-route-searchTerm="@Model.SearchCriteria.SearchTerm"
               asp-route-statusFilter="@Model.SearchCriteria.StatusFilter"
               asp-route-assignmentFilter="@Model.SearchCriteria.AssignmentFilter"
               asp-route-page="@(Model.CurrentPage + 1)"
               asp-route-pageSize="@Model.PageSize">Next</a>
        </div>
    </div>

    @if (selected != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-xl-8">
                <form asp-action="Update" method="post" class="card shadow-sm h-100">
                    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <strong>Meter configuration</strong>
                            <span class="text-muted small ms-2">#@selected.Id</span>
                        </div>
                        @if (selected.Active)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Disabled</span>
                        }
                    </div>
                    <div class="card-body">
                        <input type="hidden" name="Id" value="@selected.Id" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="meterName">Technical name *</label>
                                <input class="form-control" id="meterName" name="Name" value="@selected.Name" required maxlength="100" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="meterLabel">Display label</label>
                                <input class="form-control" id="meterLabel" name="Label" value="@selected.Label" maxlength="150" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="meterUnit">Unit</label>
                                <input class="form-control" id="meterUnit" name="Unit" value="@selected.Unit" maxlength="20" placeholder="kWh, m³..." />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="meterType">Type</label>
                                <select class="form-select" id="meterType" name="Type">
                                    <option value="Main" selected="@(selected.Type == "Main")">Main</option>
                                    <option value="Sub" selected="@(selected.Type == "Sub")">Sub</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Last reading</label>
                                <div class="form-control bg-body-tertiary">@selected.LastReading</div>
                                <div class="form-text">Read-only. Updated by imported meter data.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="meterTenant">Tenant</label>
                                <select class="form-select" id="meterTenant" name="TenantId">
                                    @foreach (var option in Model.TenantOptions)
                                    {
                                        <option value="@option.Value"
                                                disabled="@(option.Disabled && option.Value != selected.TenantId ? "disabled" : null)"
                                                selected="@(option.Value == selected.TenantId)">
                                            @option.Text
                                        </option>
                                    }
                                </select>
                                <div class="form-text">A tenant can own multiple meters. Disabled tenants cannot receive new assignments.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="meterParent">Parent meter</label>
                                <select class="form-select" id="meterParent" name="ParentMeterId">
                                    @foreach (var option in Model.ParentMeterOptions.Where(o => o.Value != selected.Id.ToString()))
                                    {
                                        <option value="@option.Value"
                                                disabled="@(option.Disabled && option.Value != selected.ParentMeterId ? "disabled" : null)"
                                                selected="@(option.Value == selected.ParentMeterId)">
                                            @option.Text
                                        </option>
                                    }
                                </select>
                                <div class="form-text">Only Main meters from this workspace can be selected as parents.</div>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="meterActive" name="Active" value="true" checked="@(selected.Active ? "checked" : null)" />
                                    <input type="hidden" name="Active" value="false" />
                                    <label class="form-check-label" for="meterActive">Active meter</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white text-end">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-save"></i> Save changes
                        </button>
                    </div>
                </form>
            </div>

            <div class="col-xl-4">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white"><strong>Lifecycle</strong></div>
                    <div class="card-body">
                        <p class="small text-muted">
                            Disable a meter to preserve its readings and invoice history while removing it from normal active operations.
                        </p>

                        <div class="d-grid gap-2">
                            @if (selected.Active)
                            {
                                <form asp-action="DisableMeter" method="post">
                                    <input type="hidden" name="meterId" value="@selected.Id" />
                                    <button class="btn btn-outline-warning w-100" type="submit"
                                            onclick="return confirm('Disable this meter? Historical readings will be preserved.');">
                                        Disable meter
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="EnableMeter" method="post">
                                    <input type="hidden" name="meterId" value="@selected.Id" />
                                    <button class="btn btn-outline-success w-100" type="submit">
                                        Enable meter
                                    </button>
                                </form>
                            }

                            <form asp-action="DeleteMeter" method="post">
                                <input type="hidden" name="meterId" value="@selected.Id" />
                                <button class="btn btn-outline-danger w-100"
                                        type="submit"
                                        disabled="@(!Model.SelectedMeterDependencies.CanDelete ? "disabled" : null)"
                                        onclick="return confirm('Permanently delete this empty meter? This cannot be undone.');">
                                    Delete permanently
                                </button>
                            </form>
                        </div>

                        @if (!Model.SelectedMeterDependencies.CanDelete)
                        {
                            <div class="alert alert-light border small mt-3 mb-0">
                                <strong>Permanent deletion protected.</strong>
                                <div class="mt-1">
                                    @Model.SelectedMeterDependencies.HistoricalReadingCount history row(s) ·
                                    @Model.SelectedMeterDependencies.BillLineCount invoice line(s) ·
                                    @Model.SelectedMeterDependencies.ChildMeterCount child meter(s)
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-white"><strong>Assignment</strong></div>
                    <div class="card-body small">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tenant</span>
                            <span class="fw-semibold">@(selected.TenantName ?? "Unassigned")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Parent</span>
                            <span class="fw-semibold">@(selected.ParentMeterName ?? "Top level")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Sub meters</span>
                            <span class="fw-semibold">@Model.SubMeters.Count</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <div>
                    <strong>Sub meters</strong>
                    <div class="small text-muted">Direct children of this meter in the current workspace.</div>
                </div>
                <span class="badge text-bg-light border">@Model.SubMeters.Count</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Meter</th>
                            <th>Tenant</th>
                            <th>Unit</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.SubMeters.Any())
                    {
                        @foreach (var sub in Model.SubMeters)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Management" asp-route-id="@sub.Id">@(sub.Label ?? sub.Name)</a>
                                    @if (!string.IsNullOrWhiteSpace(sub.Label))
                                    {
                                        <div class="small text-muted">@sub.Name</div>
                                    }
                                </td>
                                <td>@(sub.TenantName ?? "Unassigned")</td>
                                <td>@(string.IsNullOrWhiteSpace(sub.Unit) ? "—" : sub.Unit)</td>
                                <td>
                                    @if (sub.Active)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Disabled</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">No child meters.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="newMeterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form asp-action="Create" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Meter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="newMeterName">Technical name *</label>
                        <input class="form-control" id="newMeterName" name="Name" maxlength="100" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="newMeterLabel">Display label</label>
                        <input class="form-control" id="newMeterLabel" name="Label" maxlength="150" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="newMeterUnit">Unit</label>
                        <input class="form-control" id="newMeterUnit" name="Unit" maxlength="20" placeholder="kWh, m³..." />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="newMeterType">Type</label>
                        <select class="form-select" id="newMeterType" name="Type">
                            <option value="Main">Main</option>
                            <option value="Sub">Sub</option>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="newMeterActive" name="Active" value="true" checked />
                            <input type="hidden" name="Active" value="false" />
                            <label class="form-check-label" for="newMeterActive">Active</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="newMeterTenant">Tenant</label>
                        <select class="form-select" id="newMeterTenant" name="TenantId">
                            @foreach (var option in Model.TenantOptions)
                            {
                                <option value="@option.Value" disabled="@(option.Disabled ? "disabled" : null)">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="newMeterParent">Parent meter</label>
                        <select class="form-select" id="newMeterParent" name="ParentMeterId">
                            @foreach (var option in Model.ParentMeterOptions)
                            {
                                <option value="@option.Value" disabled="@(option.Disabled ? "disabled" : null)">@option.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Create meter</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="bulkEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bulk edit meters</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="cbUpdateTenant" />
                    <label class="form-check-label fw-semibold" for="cbUpdateTenant">Change tenant</label>
                </div>
                <select class="form-select mb-3" id="bulkTenantSelect">
                    @foreach (var option in Model.TenantOptions)
                    {
                        <option value="@option.Value" disabled="@(option.Disabled ? "disabled" : null)">@option.Text</option>
                    }
                </select>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="cbUpdateUnit" />
                    <label class="form-check-label fw-semibold" for="cbUpdateUnit">Change unit</label>
                </div>
                <input class="form-control mb-3" id="bulkUnitInput" maxlength="20" placeholder="kWh, m³..." />

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="cbUpdateType" />
                    <label class="form-check-label fw-semibold" for="cbUpdateType">Change type</label>
                </div>
                <select class="form-select mb-3" id="bulkTypeSelect">
                    <option value="Main">Main</option>
                    <option value="Sub">Sub</option>
                </select>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="cbUpdateParent" />
                    <label class="form-check-label fw-semibold" for="cbUpdateParent">Change parent</label>
                </div>
                <select class="form-select" id="bulkParentSelect">
                    @foreach (var option in Model.ParentMeterOptions)
                    {
                        <option value="@option.Value" disabled="@(option.Disabled ? "disabled" : null)">@option.Text</option>
                    }
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="applyBulkEdit()">Apply changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="quickAssignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Assign selected meters</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="quickTenantSelect">Tenant</label>
                <select class="form-select" id="quickTenantSelect">
                    @foreach (var option in Model.TenantOptions.Where(o => !string.IsNullOrWhiteSpace(o.Value)))
                    {
                        <option value="@option.Value" disabled="@(option.Disabled ? "disabled" : null)">@option.Text</option>
                    }
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="confirmQuickAssign()">Assign</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let selectAllMatching = false;

    function selectedMeterIds() {
        return Array.from(document.querySelectorAll('.meter-checkbox:checked'))
            .map(cb => Number.parseInt(cb.value, 10))
            .filter(Number.isFinite);
    }

    function updateBulkUi() {
        const checkboxes = Array.from(document.querySelectorAll('.meter-checkbox'));
        const selected = selectedMeterIds();
        const allVisible = checkboxes.length > 0 && selected.length === checkboxes.length;
        const bar = document.getElementById('bulkActionBar');
        const banner = document.getElementById('selectAllBannerRow');
        const header = document.getElementById('selectAllMeters');

        if (header) header.checked = allVisible && !selectAllMatching;

        if (selectAllMatching) {
            bar?.classList.remove('d-none');
            document.getElementById('selectedCount').textContent = '@Model.TotalItems';
            document.getElementById('allMatchingLabel')?.classList.remove('d-none');
            banner?.classList.remove('d-none');
            document.getElementById('bannerVisible')?.classList.add('d-none');
            document.getElementById('bannerAll')?.classList.remove('d-none');
            return;
        }

        document.getElementById('allMatchingLabel')?.classList.add('d-none');
        document.getElementById('selectedCount').textContent = selected.length.toString();
        bar?.classList.toggle('d-none', selected.length === 0);
        banner?.classList.toggle('d-none', !allVisible);
        document.getElementById('visibleSelectionCount').textContent = selected.length.toString();
        document.getElementById('bannerVisible')?.classList.remove('d-none');
        document.getElementById('bannerAll')?.classList.add('d-none');
    }

    document.getElementById('selectAllMeters')?.addEventListener('change', event => {
        selectAllMatching = false;
        document.querySelectorAll('.meter-checkbox').forEach(cb => cb.checked = event.target.checked);
        updateBulkUi();
    });

    document.querySelectorAll('.meter-checkbox').forEach(cb => {
        cb.addEventListener('change', () => {
            selectAllMatching = false;
            updateBulkUi();
        });
    });

    window.selectAllAcrossPages = function() {
        if (@Model.TotalItems <= 0) return;
        selectAllMatching = true;
        document.querySelectorAll('.meter-checkbox').forEach(cb => cb.checked = true);
        updateBulkUi();
    };

    window.clearAllAcrossPages = function() {
        selectAllMatching = false;
        document.querySelectorAll('.meter-checkbox').forEach(cb => cb.checked = false);
        const header = document.getElementById('selectAllMeters');
        if (header) header.checked = false;
        updateBulkUi();
    };

    function verificationToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    async function postJson(url, payload) {
        const response = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': verificationToken()
            },
            body: JSON.stringify(payload)
        });

        const data = await response.json();
        if (!response.ok || !data.success) {
            throw new Error(data.message || 'Operation failed.');
        }

        return data;
    }

    function baseBulkPayload() {
        return {
            MeterIds: selectedMeterIds(),
            SelectAllMatching: selectAllMatching,
            SearchField: '@Model.SearchCriteria.SearchField',
            SearchTerm: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SearchCriteria.SearchTerm)),
            StatusFilter: '@Model.SearchCriteria.StatusFilter',
            AssignmentFilter: '@Model.SearchCriteria.AssignmentFilter'
        };
    }

    async function sendBulkEditRequest(editData) {
        if (!selectAllMatching && selectedMeterIds().length === 0) {
            alert('Select at least one meter.');
            return;
        }

        try {
            const data = await postJson('/Meter/BulkEditMeters', {
                ...baseBulkPayload(),
                ...editData
            });
            alert(data.message);
            location.reload();
        } catch (error) {
            alert(error.message);
        }
    }

    window.quickAssignSelected = function() {
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('quickAssignModal'));
        modal.show();
    };

    window.confirmQuickAssign = function() {
        const value = document.getElementById('quickTenantSelect').value;
        if (!value) {
            alert('Select a tenant.');
            return;
        }

        sendBulkEditRequest({
            UpdateTenant: true,
            TenantId: Number.parseInt(value, 10)
        });
    };

    window.unassignBulkTenant = function() {
        if (!confirm('Unassign the selected meter(s) from their tenant?')) return;
        sendBulkEditRequest({ UpdateTenant: true, TenantId: null });
    };

    window.setBulkMetersActive = function(active) {
        const action = active ? 'enable' : 'disable';
        if (!confirm(`Are you sure you want to ${action} the selected meter(s)? Historical readings will be preserved.`)) return;

        sendBulkEditRequest({
            UpdateActive: true,
            Active: active
        });
    };

    window.applyBulkEdit = function() {
        const updateTenant = document.getElementById('cbUpdateTenant').checked;
        const updateUnit = document.getElementById('cbUpdateUnit').checked;
        const updateType = document.getElementById('cbUpdateType').checked;
        const updateParent = document.getElementById('cbUpdateParent').checked;

        if (!updateTenant && !updateUnit && !updateType && !updateParent) {
            alert('Select at least one field to change.');
            return;
        }

        const tenantValue = document.getElementById('bulkTenantSelect').value;
        const parentValue = document.getElementById('bulkParentSelect').value;

        sendBulkEditRequest({
            UpdateTenant: updateTenant,
            TenantId: tenantValue ? Number.parseInt(tenantValue, 10) : null,
            UpdateUnit: updateUnit,
            Unit: document.getElementById('bulkUnitInput').value,
            UpdateType: updateType,
            Type: document.getElementById('bulkTypeSelect').value,
            UpdateParent: updateParent,
            ParentId: parentValue ? Number.parseInt(parentValue, 10) : null
        });
    };

    window.deleteBulkMeters = async function() {
        if (selectAllMatching) {
            alert('For safety, permanent deletion is only available for explicitly checked meters.');
            return;
        }

        const ids = selectedMeterIds();
        if (ids.length === 0) {
            alert('Select at least one meter.');
            return;
        }

        if (!confirm(`Permanently delete ${ids.length} selected empty meter(s)? Meters with readings, invoice references or child meters will be protected.`)) return;

        try {
            const data = await postJson('/Meter/BulkDeleteMeters', ids);
            alert(data.message);
            location.reload();
        } catch (error) {
            alert(error.message);
        }
    };

    updateBulkUi();
</script>
}
