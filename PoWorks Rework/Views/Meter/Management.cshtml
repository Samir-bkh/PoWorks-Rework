@* 
    Meter Management View (PoWorks)
    
    Provides a comprehensive management interface for metering infrastructure.
    Features include advanced search/filtering, paginated results table with single and 
    cross-page bulk selection ("Select all matching in database"), individual meter details 
    editing (parent hierarchy, label, tenant assignment, active status), sub-meter 
    hierarchy visualization, bulk edit modal (multi-property updates), and bulk deletion capabilities.
*@

@model PoWorks_Rework.Models.MeterManagementViewModel
@{
    ViewData["Title"] = "Meter Management";
}

@* Feedback Alerts: Operations Status Notifications *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    @* Card Header *@
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Meters</h4>
    </div>
    <div class="card-body">
        
        @* Section Navigation Tabs *@
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Meter" asp-action="Readings">Meter Readings</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" asp-controller="Meter" asp-action="Management">Meter Management</a>
            </li>
        </ul>

        @* SECTION 1: Meter Search and Filter Form *@
        <form asp-action="Search" method="post" id="searchForm">
            <div class="meter-search-area mb-4">
                @* Criteria Selection Row *@
                <div class="row mb-2">
                    <div class="col-md-2">
                        <label for="SearchField" class="form-label">Search Criteria</label>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select" id="SearchField" asp-for="SearchCriteria.SearchField" onchange="updateMeterSearchOptions()">
                            <option value="Name">Name or Label</option>
                            <option value="Type">Type</option>
                            <option value="Tenant">Tenant</option>
                        </select>
                    </div>
                </div>

                @* Dynamic Search Value Input Row *@
                <div class="row mb-3">
                    <div class="col-md-2">
                        <label for="SearchTerm" class="form-label">Search Term</label>
                    </div>
                    <div class="col-md-4">
                        <div id="searchTermContainer">
                            @* Free Text Search (Name/Label) *@
                            <input type="text" class="form-control" id="textInput" asp-for="SearchCriteria.SearchTerm"
                                   style="display: @(Model.SearchCriteria?.SearchField == "Name" ? "block" : "none")">
                            
                            @* Type Select Dropdown *@
                            <select class="form-select" id="typeSelect" name="SearchCriteria.SearchTerm"
                                    style="display: @(Model.SearchCriteria?.SearchField == "Type" ? "block" : "none")">
                                <option value="">Select Type</option>
                                <option value="Main" selected="@(Model.SearchCriteria?.SearchTerm == "Main")">Main</option>
                                <option value="Sub" selected="@(Model.SearchCriteria?.SearchTerm == "Sub")">Sub</option>
                            </select>

                            @* Tenant Select Dropdown *@
                            <select class="form-select" id="tenantSelect" name="SearchCriteria.SearchTerm"
                                    style="display: @(Model.SearchCriteria?.SearchField == "Tenant" ? "block" : "none")">
                                <option value="">Select Tenant</option>
                                @if(Model.TenantOptions != null) {
                                    @foreach (var tenant in Model.TenantOptions)
                                    {
                                        <option value="@tenant.Text" selected="@(Model.SearchCriteria?.SearchTerm == tenant.Text)">@tenant.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    
                    @* Search Actions *@
                    <div class="col-md-6 d-flex align-items-center">
                        <button type="submit" class="btn btn-primary me-2">Search</button>
                        <button type="button" class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#newMeterModal">New Meter</button>
                    </div>
                </div>
            </div>
        </form>

        @* SECTION 2: Search Results Table Container *@
        <div class="card mb-4">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Search Results</h5>
                </div>
                
                @* Bulk Action Operations Bar (Revealed dynamically when items are checked) *@
                <div id="bulkActionBar" class="bg-primary-subtle p-2 rounded d-flex align-items-center justify-content-between border border-primary" style="display: none !important;">
                    <div>
                        <span class="badge bg-primary fs-6"><span id="selectedCount">0</span> selected</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#bulkEditModal"><i class="bi bi-pencil-square"></i> Edit Selected</button>
                        <button class="btn btn-sm btn-warning fw-bold text-dark" onclick="unassignBulkTenant()"><i class="bi bi-person-x"></i> Unassign</button>
                        <div class="vr mx-1"></div>
                        <button class="btn btn-sm btn-danger fw-bold" onclick="deleteBulkMeters()"><i class="bi bi-trash"></i> Delete</button>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        @* Table Headers *@
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 50px;">
                                    <input class="form-check-input" type="checkbox" id="selectAllMeters">
                                </th>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Parent</th>
                                <th>Last Reading</th>
                                <th>Unit</th>
                                <th>Tenant</th>
                                <th>Active</th>
                            </tr>
                        </thead>

                        <tbody>
                            @* Banner Row: Cross-Page Global Selection Option *@
                            <tr id="selectAllBannerRow" style="display: none;">
                                <td colspan="8" class="text-center bg-primary-subtle text-primary border-primary py-2">
                                    <span id="bannerTextNormal">
                                        All <strong><span id="bannerPageCount">50</span></strong> meters on this page are selected. 
                                        <a href="#" class="fw-bold text-decoration-none ms-2" onclick="selectAllAcrossPages(event)">
                                            Select all matching meters in database
                                        </a>
                                    </span>
                                    <span id="bannerTextAll" style="display: none;">
                                        <i class="bi bi-check-circle-fill"></i> All matching meters are selected.
                                        <a href="#" class="fw-bold text-decoration-none ms-2 text-danger" onclick="clearAllAcrossPages(event)">
                                            Clear selection
                                        </a>
                                    </span>
                                </td>
                            </tr>
                            
                            @* Result Rows *@
                            @if(Model.SearchResults != null) {
                                @foreach (var meter in Model.SearchResults)
                                {
                                    <tr class="@(Model.SelectedMeter?.Id == meter.Id ? "table-primary" : "")">
                                        <td class="text-center">
                                            <input class="form-check-input meter-checkbox" type="checkbox" value="@meter.Id">
                                        </td>
                                        <td><a asp-action="Management" asp-route-id="@meter.Id">@meter.Name</a></td>
                                        <td>@meter.Type</td>
                                        <td>@meter.ParentMeterName</td>
                                        <td>@meter.LastReading</td>
                                        <td>@meter.Unit</td>
                                        <td>@meter.TenantName</td>
                                        <td class="text-center">
                                            @if (meter.Active) { <i class="bi bi-check"></i> }
                                        </td>
                                    </tr>
                                }
                            }
                            
                            @* Empty State Row *@
                            @if (Model.SearchResults == null || !Model.SearchResults.Any())
                            {
                                <tr><td colspan="8" class="text-center">No meters found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                @* Table Pagination Controls *@
                <div class="d-flex justify-content-between align-items-center p-2 bg-light border-top">
                    <div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-action="Management" asp-route-page="@(Model.CurrentPage - 1)" aria-label="Previous">&laquo;</a>
                                    </li>
                                }
                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Management" asp-route-page="@i">@i</a>
                                    </li>
                                }
                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-action="Management" asp-route-page="@(Model.CurrentPage + 1)" aria-label="Next">&raquo;</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                    <div>
                        <span class="text-muted">@Model.CurrentPage of @Model.TotalPages pages (@Model.TotalItems items)</span>
                    </div>
                </div>
            </div>
        </div>

        @* SECTION 3: Selected Meter Configuration & Sub-Meter Hierarchy *@
        @if (Model.SelectedMeter != null)
        {
            @* Detailed Configuration Form *@
            <form method="post">
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Meter Details</h5>
                    </div>
                    <div class="card-body">
                        <input type="hidden" name="Id" value="@Model.SelectedMeter.Id" />

                        @* Name and Parent Meter Selection *@
                        <div class="row mb-3">
                            <div class="col-md-2"><label for="Name" class="form-label">Name</label></div>
                            <div class="col-md-4">
                                <input type="text" class="form-control" id="Name" name="Name" value="@Model.SelectedMeter.Name">
                                <small class="form-text text-muted">Technical name used internally</small>
                            </div>
                            <div class="col-md-2"><label for="ParentMeterId" class="form-label">Parent</label></div>
                            <div class="col-md-4">
                                @{
                                    var parentOptions = new List<SelectListItem> { new SelectListItem { Value = "", Text = "None" } };
                                    if(Model.SearchResults != null) {
                                        foreach (var meter in Model.SearchResults.Where(m => m.Id != Model.SelectedMeter.Id))
                                        {
                                            bool isSelected = meter.Id.ToString() == Model.SelectedMeter.ParentMeterId;
                                            parentOptions.Add(new SelectListItem { Value = meter.Id.ToString(), Text = meter.Name, Selected = isSelected });
                                        }
                                    }
                                }
                                <select class="form-select" id="ParentMeterId" name="ParentMeterId" asp-items="parentOptions"></select>
                            </div>
                        </div>

                        @* Display Label and Tenant Association *@
                        <div class="row mb-3">
                            <div class="col-md-2"><label for="Label" class="form-label">Label</label></div>
                            <div class="col-md-4">
                                <input type="text" class="form-control" id="Label" name="Label" value="@Model.SelectedMeter.Label" placeholder="Display name for this meter">
                                <small class="form-text text-muted">Friendly name displayed in the interface</small>
                            </div>
                            <div class="col-md-2"><label for="TenantId" class="form-label">Tenant</label></div>
                            <div class="col-md-4">
                                <select class="form-select" id="TenantId" name="TenantId" asp-items="Model.TenantOptions ?? new List<SelectListItem>()"></select>
                                <small class="form-text text-muted">Link this meter to a tenant from the database</small>
                            </div>
                        </div>

                        @* Engineering Unit and Read-Only Last Reading *@
                        <div class="row mb-3">
                            <div class="col-md-2"><label for="Unit" class="form-label">Unit</label></div>
                            <div class="col-md-4"><input type="text" class="form-control" id="Unit" name="Unit" value="@Model.SelectedMeter.Unit"></div>
                            <div class="col-md-2"><label for="LastReading" class="form-label">Last Reading</label></div>
                            <div class="col-md-4"><input type="text" class="form-control bg-light" id="LastReading" name="LastReading" value="@Model.SelectedMeter.LastReading" readonly></div>
                        </div>

                        @* Meter Classification Type and Active Status *@
                        <div class="row mb-3">
                            <div class="col-md-2"><label for="Type" class="form-label">Type</label></div>
                            <div class="col-md-4">
                                @{
                                    var typeOptions = new List<SelectListItem> {
                                        new SelectListItem { Value = "Main", Text = "Main", Selected = Model.SelectedMeter.Type == "Main" },
                                        new SelectListItem { Value = "Sub", Text = "Sub", Selected = Model.SelectedMeter.Type == "Sub" }
                                    };
                                }
                                <select class="form-select" id="Type" name="Type" asp-items="typeOptions"></select>
                            </div>
                            <div class="col-md-2"><label for="Active" class="form-label">Active</label></div>
                            <div class="col-md-4">
                                <div class="form-check mt-2">
                                    @Html.CheckBox("Active", Model.SelectedMeter.Active, new { @class = "form-check-input" })
                                    <label class="form-check-label" for="Active">Active</label>
                                </div>
                            </div>
                        </div>

                        @* Individual Meter Actions *@
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary me-2" asp-action="Update">Update</button>
                            <button type="submit" class="btn btn-success" asp-action="Create">Save as New</button>
                        </div>
                    </div>
                </div>
            </form>
            
            @* Sub-Meters Hierarchy Grid *@
            <div class="card">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Sub Meters</h5>
                </div>
                <div class="card-body">
                    @if (Model.SubMeters != null && Model.SubMeters.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Last Reading</th>
                                        <th>Unit</th>
                                        <th>Tenant</th>
                                        <th>Active</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var subMeter in Model.SubMeters)
                                    {
                                        <tr>
                                            <td><a asp-action="Management" asp-route-id="@subMeter.Id">@subMeter.Name</a></td>
                                            <td>@subMeter.Type</td>
                                            <td>@subMeter.LastReading</td>
                                            <td>@subMeter.Unit</td>
                                            <td>@subMeter.TenantName</td>
                                            <td class="text-center">@if (subMeter.Active) { <i class="bi bi-check"></i> }</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No sub meters found.</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

@* MODAL 1: Bulk Edit Selected Meters *@
<div class="modal fade" id="bulkEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bulk Edit Meters</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @* Bulk Field: Tenant Update *@
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="cbUpdateTenant" onchange="toggleBulkField('bulkTenantSelect')">
                    <label class="form-check-label fw-bold" for="cbUpdateTenant">Change Tenant</label>
                </div>
                <select class="form-select mb-4" id="bulkTenantSelect" disabled>
                    <option value="">-- Select a Tenant --</option>
                    @if(Model.TenantOptions != null) {
                        @foreach (var tenant in Model.TenantOptions.Where(t => t.Value != ""))
                        {
                            <option value="@tenant.Value">@tenant.Text</option>
                        }
                    }
                </select>

                @* Bulk Field: Unit Update *@
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="cbUpdateUnit" onchange="toggleBulkField('bulkUnitInput')">
                    <label class="form-check-label fw-bold" for="cbUpdateUnit">Change Unit</label>
                </div>
                <input type="text" class="form-control mb-4" id="bulkUnitInput" disabled placeholder="e.g. kWh, m3...">

                @* Bulk Field: Meter Type Update *@
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="cbUpdateType" onchange="toggleBulkField('bulkTypeSelect')">
                    <label class="form-check-label fw-bold" for="cbUpdateType">Change Type</label>
                </div>
                <select class="form-select mb-4" id="bulkTypeSelect" disabled>
                    <option value="Main">Main</option>
                    <option value="Sub">Sub</option>
                </select>

                @* Bulk Field: Parent Meter Hierarchy Update *@
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="cbUpdateParent" onchange="toggleBulkField('bulkParentSelect')">
                    <label class="form-check-label fw-bold" for="cbUpdateParent">Change Parent Meter</label>
                </div>
                <select class="form-select mb-2" id="bulkParentSelect" disabled>
                    <option value="">None (Top Level)</option>
                    @if(Model.SearchResults != null) {
                        @foreach (var meter in Model.SearchResults)
                        {
                            <option value="@meter.Id">@meter.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="applyBulkEdit()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@* MODAL 2: Create Single New Meter *@
<div class="modal fade" id="newMeterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">New Meter</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-3"><label class="form-label">Name</label></div>
                        <div class="col-md-9"><input type="text" class="form-control" name="Name" required></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3"><label class="form-label">Label</label></div>
                        <div class="col-md-9"><input type="text" class="form-control" name="Label"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Client-Side Management Scripts *@
@section Scripts {
    <script>
        /**
         * Dynamic Search Input Handler
         * Updates input element visibility and name attributes based on the selected search field criteria.
         */
        function updateMeterSearchOptions() {
            const criteria = document.getElementById('SearchField').value;
            
            document.getElementById('textInput').style.display = 'none';
            document.getElementById('typeSelect').style.display = 'none';
            document.getElementById('tenantSelect').style.display = 'none';
            
            document.getElementById('textInput').name = '';
            document.getElementById('typeSelect').name = '';
            document.getElementById('tenantSelect').name = '';
            
            if (criteria === 'Name') {
                document.getElementById('textInput').style.display = 'block';
                document.getElementById('textInput').name = 'SearchCriteria.SearchTerm';
            } else if (criteria === 'Type') {
                document.getElementById('typeSelect').style.display = 'block';
                document.getElementById('typeSelect').name = 'SearchCriteria.SearchTerm';
            } else if (criteria === 'Tenant') {
                document.getElementById('tenantSelect').style.display = 'block';
                document.getElementById('tenantSelect').name = 'SearchCriteria.SearchTerm';
            }
        }

        // Initialize view state and restore selected tenant options on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateMeterSearchOptions();
            
            const tenantId = '@Model.SelectedMeter?.TenantId';
            if (tenantId) {
                const tenantSelect = document.getElementById('TenantId');
                if (tenantSelect) {
                    for (let i = 0; i < tenantSelect.options.length; i++) {
                        if (tenantSelect.options[i].value === tenantId) {
                            tenantSelect.options[i].selected = true;
                            break;
                        }
                    }
                }
            }
        });

        // Global flag tracking whether "Select All Matching Across Database Pages" is active
        let isSelectingAcrossPages = false;
        
        /**
         * Updates the bulk actions bar visibility, counter, and selection banner states.
         */
        function updateBulkUI() {
            const selectAll = document.getElementById('selectAllMeters');
            const checkboxes = document.querySelectorAll('.meter-checkbox');
            const bulkActionBar = document.getElementById('bulkActionBar');
            const selectedCount = document.getElementById('selectedCount');
            const selectAllBannerRow = document.getElementById('selectAllBannerRow');
            
            const checkedCount = document.querySelectorAll('.meter-checkbox:checked').length;
            const itemsOnPage = checkboxes.length;
            
            if (isSelectingAcrossPages) {
                selectedCount.innerText = "All matching";
                bulkActionBar.style.setProperty('display', 'flex', 'important');
                return;
            }

            selectedCount.innerText = checkedCount;
            bulkActionBar.style.setProperty('display', checkedCount > 0 ? 'flex' : 'none', 'important');
            
            if(selectAll) {
                selectAll.checked = (checkedCount === itemsOnPage && itemsOnPage > 0);
            }

            if (selectAll && selectAll.checked && itemsOnPage > 0) {
                selectAllBannerRow.style.display = 'table-row';
                document.getElementById('bannerPageCount').innerText = itemsOnPage;
                document.getElementById('bannerTextNormal').style.display = 'inline';
                document.getElementById('bannerTextAll').style.display = 'none';
            } else {
                if(selectAllBannerRow) selectAllBannerRow.style.display = 'none';
            }
        }

        /**
         * Activates global selection across all paginated records in the database.
         */
        window.selectAllAcrossPages = function(e) {
            e.preventDefault();
            isSelectingAcrossPages = true;
            document.getElementById('bannerTextNormal').style.display = 'none';
            document.getElementById('bannerTextAll').style.display = 'inline';
            updateBulkUI();
        };

        /**
         * Resets cross-page global selection state.
         */
        window.clearAllAcrossPages = function(e) {
            e.preventDefault();
            isSelectingAcrossPages = false;
            document.getElementById('selectAllMeters').checked = false;
            document.querySelectorAll('.meter-checkbox').forEach(cb => cb.checked = false);
            updateBulkUI();
        };

        // Header checkbox listener to toggle all visible rows
        document.getElementById('selectAllMeters')?.addEventListener('change', e => {
            isSelectingAcrossPages = false;
            document.querySelectorAll('.meter-checkbox').forEach(cb => cb.checked = e.target.checked);
            updateBulkUI();
        });

        // Individual row checkbox listeners
        document.querySelectorAll('.meter-checkbox').forEach(cb => cb.addEventListener('change', () => {
            isSelectingAcrossPages = false;
            updateBulkUI();
        }));

        /**
         * Enables/disables form inputs within the bulk edit modal.
         */
        window.toggleBulkField = function(fieldId) {
            const field = document.getElementById(fieldId);
            field.disabled = !field.disabled;
        };

        /**
         * Unassigns tenant associations from all selected meters.
         */
        window.unassignBulkTenant = function() {
            if(!confirm('Are you sure you want to unassign tenants for selected meters?')) return;
            sendBulkEditRequest({ UpdateTenant: true, TenantId: null });
        };

        /**
         * Compiles user inputs from the bulk edit modal and submits the request.
         */
        window.applyBulkEdit = function() {
            const updateTenant = document.getElementById('cbUpdateTenant').checked;
            const tenantId = document.getElementById('bulkTenantSelect').value;
            const updateUnit = document.getElementById('cbUpdateUnit').checked;
            const unit = document.getElementById('bulkUnitInput').value;
            const updateType = document.getElementById('cbUpdateType').checked;
            const type = document.getElementById('bulkTypeSelect').value;
            const updateParent = document.getElementById('cbUpdateParent').checked;
            const parentId = document.getElementById('bulkParentSelect').value;

            if(!updateTenant && !updateUnit && !updateType && !updateParent) {
                alert("Please select at least one field to update.");
                return;
            }

            sendBulkEditRequest({
                UpdateTenant: updateTenant, TenantId: tenantId ? parseInt(tenantId) : null,
                UpdateUnit: updateUnit, Unit: unit,
                UpdateType: updateType, Type: type,
                UpdateParent: updateParent, ParentId: parentId ? parseInt(parentId) : null
            });
        };

        /**
         * Sends an asynchronous bulk edit HTTP POST request to the server API.
         */
        function sendBulkEditRequest(editData) {
            const selectedIds = Array.from(document.querySelectorAll('.meter-checkbox:checked')).map(cb => parseInt(cb.value));
            const searchField = document.getElementById('SearchField') ? document.getElementById('SearchField').value : null;
            const searchTerm = document.querySelector('input[name="SearchCriteria.SearchTerm"]') ? document.querySelector('input[name="SearchCriteria.SearchTerm"]').value : null;

            if(selectedIds.length === 0 && !isSelectingAcrossPages) return;

            const payload = { 
                MeterIds: selectedIds, 
                SelectAllMatching: isSelectingAcrossPages,
                SearchField: searchField,
                SearchTerm: searchTerm,
                ...editData
            };

            fetch('/Meter/BulkEditMeters', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).then(res => res.json()).then(data => {
                if (data.success) location.reload();
                else alert('Error: ' + data.message);
            });
        }

        /**
         * Sends an asynchronous bulk deletion HTTP POST request after user confirmation.
         */
        window.deleteBulkMeters = function() {
            const selectedIds = Array.from(document.querySelectorAll('.meter-checkbox:checked')).map(cb => parseInt(cb.value));
            if(!confirm(`Warning: You are about to permanently delete ${selectedIds.length} meters and all their historical readings. Are you sure?`)) return;

            fetch('/Meter/BulkDeleteMeters', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(selectedIds)
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) location.reload();
                else alert('Error: ' + data.message);
            });
        };
    </script>
}