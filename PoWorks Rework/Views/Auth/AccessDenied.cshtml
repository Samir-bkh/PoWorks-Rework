@*
    Access Denied View (PoWorks)

Displays a full-page, standalone layout for unauthorized access attempts.
    Informs users when they lack sufficient permissions and provides a navigation
    link back to the main dashboard.
*@

@{
    // Configure page title and disable the shared master layout to display as a standalone page
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PoWorks</title>

    @* Core Stylesheets *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">

    @* Access Denied Notice Container *@
    <div class="text-center">
        @* Visual indicator *@
        <i class="fas fa-lock text-danger fa-5x mb-4"></i>

        @* Error details *@
        <h1 class="display-4 fw-bold">Access Denied</h1>
        <p class="lead text-muted">You do not have permission to view this directory or page.</p>

        @* Navigation action *@
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
            <i class="fas fa-arrow-left"></i> Return to Dashboard
        </a>
    </div>

</body>
</html>