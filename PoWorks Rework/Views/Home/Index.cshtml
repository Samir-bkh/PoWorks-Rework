@{
    ViewData["Title"] = "Analytics";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/dashboard-modern.css" asp-append-version="true" />

<div class="dashboard-shell">
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show dashboard-alert" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <header class="analytics-header">
        <div class="analytics-heading">
            <div class="analytics-title-row">
                <h1>Analytics</h1>
                <span class="analytics-workspace">
                    <i class="bi bi-building"></i>
                    <span id="dashboardWorkspaceContext">@ViewData["CurrentTenant"]</span>
                </span>
            </div>
            <div class="analytics-context-line" aria-label="Current dashboard context">
                <span><strong id="dashboardTenantContext">All tenants</strong></span>
                <span class="analytics-context-separator">/</span>
                <span><strong id="dashboardMetricContext">Energy consumption</strong></span>
                <span class="analytics-context-separator">/</span>
                <span id="dashboardViewContext">Aggregate</span>
                <span class="analytics-context-separator">/</span>
                <span id="dashboardPeriodContext">Loading…</span>
                <span class="analytics-context-separator">/</span>
                <span id="dashboardUnitContext">—</span>
            </div>
        </div>

        <div class="analytics-header-actions">
            <button id="autoRefresh" class="btn analytics-icon-btn" type="button"
                    title="Toggle 30-second live refresh">
                <i class="bi bi-broadcast-pin"></i>
                <span class="d-none d-xxl-inline">Live</span>
            </button>
            <div class="dropdown">
                <button class="btn analytics-icon-btn dropdown-toggle" type="button"
                        id="exportMenu" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-download"></i>
                    <span class="d-none d-xxl-inline">Export</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="exportMenu">
                    <li>
                        <button id="exportChart" class="dropdown-item" type="button">
                            <i class="bi bi-image me-2"></i>Chart as PNG
                        </button>
                    </li>
                    <li>
                        <button id="exportCsv" class="dropdown-item" type="button">
                            <i class="bi bi-filetype-csv me-2"></i>Data as CSV
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <section class="analytics-commandbar" aria-label="Dashboard filters">
        <select id="dateFilter" class="d-none" aria-hidden="true">
            <option value="hourly">Hourly</option>
            <option value="daily" selected>Daily</option>
            <option value="monthly">Monthly</option>
            <option value="yearly">Yearly</option>
        </select>

        <div class="analytics-filter analytics-filter-tenant">
            <label for="tenantFilter">Tenant</label>
            <select id="tenantFilter" class="form-select form-select-sm">
                <option value="">All tenants</option>
            </select>
        </div>

        <div class="analytics-filter analytics-filter-metric">
            <label for="measurementMetric">Measurement</label>
            <select id="measurementMetric" class="form-select form-select-sm">
                <option value="energy">Energy consumption</option>
            </select>
        </div>

        <div class="analytics-filter analytics-filter-period">
            <label>Period</label>
            <div class="analytics-date-range">
                <input type="date" id="startDate" class="form-control form-control-sm" aria-label="Start date" />
                <span>–</span>
                <input type="date" id="endDate" class="form-control form-control-sm" aria-label="End date" />
            </div>
        </div>

        <div class="analytics-granularity" role="group" aria-label="Time aggregation">
            <button type="button" class="btn btn-sm" id="tabHourly">Hour</button>
            <button type="button" class="btn btn-sm active" id="tabDaily">Day</button>
            <button type="button" class="btn btn-sm" id="tabMonthly">Month</button>
            <button type="button" class="btn btn-sm" id="tabYearly">Year</button>
        </div>

        <div class="analytics-mode-switch" role="group" aria-label="Comparison mode">
            <input type="radio" class="btn-check" name="viewMode" id="modeStandard" value="standard" autocomplete="off" checked>
            <label class="btn btn-sm" for="modeStandard">Standard</label>
            <input type="radio" class="btn-check" name="viewMode" id="modeComparison" value="comparison" autocomplete="off">
            <label class="btn btn-sm" for="modeComparison">Compare</label>
        </div>

        <button id="applyFilters" class="btn btn-sm btn-primary analytics-apply-btn" type="button">
            <i class="bi bi-arrow-repeat"></i>
            <span>Apply</span>
        </button>

        <button class="btn btn-sm analytics-more-btn collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#advancedAnalyticsPanel"
                aria-expanded="false"
                aria-controls="advancedAnalyticsPanel">
            <i class="bi bi-sliders"></i>
            <span>More</span>
        </button>
    </section>

    <section class="collapse analytics-advanced-panel" id="advancedAnalyticsPanel">
        <div class="analytics-advanced-grid">
            <div class="analytics-filter">
                <label for="scopeMode">Series view</label>
                <select id="scopeMode" class="form-select form-select-sm">
                    <option value="aggregate" selected>Aggregate selection</option>
                    <option value="tenant">Break down by tenant</option>
                    <option value="meter">Individual meters</option>
                </select>
                <small id="scopeDescription">One physically meaningful line for the selected scope.</small>
            </div>

            <div class="analytics-filter">
                <label for="aggregationMode">Aggregation</label>
                <select id="aggregationMode" class="form-select form-select-sm"></select>
                <small id="metricDescription"></small>
            </div>

            <div class="analytics-filter analytics-source-filter">
                <label>Meters / sensors</label>
                <div class="dropdown w-100">
                    <button class="form-select form-select-sm text-start d-flex justify-content-between align-items-center"
                            type="button"
                            id="meterDropdownBtn"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            data-bs-auto-close="outside">
                        <span id="meterDropdownText" class="text-truncate text-muted">All compatible sources</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu w-100 p-2 shadow-sm"
                        aria-labelledby="meterDropdownBtn"
                        id="meterFilterContainer">
                        <li><span class="dropdown-item-text text-muted">Loading sources…</span></li>
                    </ul>
                </div>
                <small id="meterCompatibilityHint">Compatible sources are selected automatically.</small>
            </div>

            <div class="analytics-filter">
                <label for="chartType">Chart</label>
                <select id="chartType" class="form-select form-select-sm">
                    <option value="line" selected>Line</option>
                    <option value="area">Area</option>
                    <option value="bar">Bar</option>
                </select>
            </div>

            <div class="analytics-filter">
                <label for="meterLimit">Ranking</label>
                <select id="meterLimit" class="form-select form-select-sm">
                    <option value="3">Top 3</option>
                    <option value="5" selected>Top 5</option>
                    <option value="10">Top 10</option>
                    <option value="20">Top 20</option>
                </select>
            </div>

            <div class="analytics-filter">
                <label for="maxCurves">Visible series</label>
                <select id="maxCurves" class="form-select form-select-sm">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
            </div>

            <div class="analytics-advanced-actions">
                <button id="refreshMeters" class="btn btn-sm btn-outline-secondary" type="button">
                    <i class="bi bi-arrow-clockwise"></i> Refresh sources
                </button>
                <button id="resetFilters" class="btn btn-sm btn-outline-secondary" type="button">
                    Reset
                </button>
            </div>
        </div>
    </section>

    <section class="analytics-comparison-strip d-none" id="comparisonOptions">
        <div class="analytics-comparison-title">
            <i class="bi bi-intersect"></i>
            <span>Compare</span>
        </div>

        <div class="analytics-filter analytics-comparison-filter">
            <label for="comparePreset">Reference</label>
            <select id="comparePreset" class="form-select form-select-sm">
                <option value="previous" selected>Previous period</option>
                <option value="lastYear">Same period last year</option>
                <option value="custom">Custom start</option>
            </select>
        </div>

        <div class="analytics-filter analytics-comparison-filter d-none" id="compareCustomDates">
            <label for="compareStartDate">Start</label>
            <input type="date" id="compareStartDate" class="form-control form-control-sm" />
        </div>

        <div class="analytics-comparison-resolved" id="comparisonResolvedRange">—</div>
    </section>

    <section class="analytics-kpi-strip" aria-label="Analytical KPIs">
        @for (var i = 1; i <= 4; i++)
        {
            <article class="analytics-kpi">
                <div class="analytics-kpi-label" id="kpi@(i)Label">—</div>
                <div class="analytics-kpi-value" id="kpi@(i)Value">—</div>
                <div class="analytics-kpi-detail" id="kpi@(i)Detail">Waiting for data</div>
                <div class="dashboard-kpi-compare d-none" id="kpi@(i)Compare"></div>
            </article>
        }
    </section>

    <section class="analytics-workbench">
        <article class="analytics-chart-panel">
            <header class="analytics-panel-header">
                <div class="analytics-chart-heading">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h2 id="chartTitle">Energy consumption</h2>
                        <span class="analytics-unit-badge" id="chartUnitBadge">
                            <span>—</span>
                        </span>
                        <span class="dashboard-quality-pill" id="coverageBadge"
                              title="Share of expected meter/bucket combinations containing data">
                            <i class="bi bi-database-check"></i>
                            <span>Coverage —</span>
                        </span>
                    </div>
                    <div id="chartSubtitle" class="analytics-panel-subtitle">
                        Building aggregate
                    </div>
                </div>

                <div class="analytics-chart-actions">
                    <button id="resetZoomBtn" class="btn analytics-icon-btn" type="button" title="Reset zoom">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <button id="fullscreenChart" class="btn analytics-icon-btn" type="button" title="Full screen">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </button>
                </div>
            </header>

            <div id="curveLimitWarning" class="analytics-inline-warning d-none">
                <i class="bi bi-info-circle"></i>
                <span id="curveLimitWarningText"></span>
            </div>

            <div id="dataStatus" class="analytics-status">
                <span class="analytics-status-dot"></span>
                <span id="dataStatusText">Loading dashboard context…</span>
            </div>

            <div class="chart-stage">
                <div id="chartdiv"></div>

                <div id="loadingSpinner" class="chart-loading-overlay d-none">
                    <div class="text-center">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Loading…</span>
                        </div>
                        <div class="fw-semibold mt-2">Updating analytics…</div>
                    </div>
                </div>

                <div id="chartEmptyState" class="chart-empty-state d-none">
                    <div class="chart-empty-content">
                        <div class="chart-empty-icon"><i class="bi bi-graph-up"></i></div>
                        <h5 id="chartEmptyTitle">No compatible data</h5>
                        <p id="chartEmptyMessage">Adjust the current selection.</p>
                    </div>
                </div>
            </div>
        </article>

        <aside class="analytics-side-panel">
            <header class="analytics-panel-header analytics-ranking-header">
                <div>
                    <h2 id="topConsumersTitle">
                        <i class="bi bi-bar-chart-fill"></i> Ranking
                    </h2>
                    <div class="analytics-panel-subtitle" id="rankingDescription">
                        Ranked within the current analytical scope.
                    </div>
                </div>
                <span id="rankingScopeBadge" class="analytics-scope-badge">Workspace</span>
            </header>

            <div class="analytics-ranking-body" id="topConsumersList">
                <div class="analytics-ranking-empty">Loading ranking…</div>
            </div>
        </aside>
    </section>
</div>

@section Scripts {
    <script src="~/lib/amcharts/lib/5/index.js"></script>
    <script src="~/lib/amcharts/lib/5/xy.js"></script>
    <script src="~/lib/amcharts/lib/5/themes/Animated.js"></script>
    <script src="~/lib/amcharts/lib/5/plugins/exporting.js"></script>
    <script src="~/js/energy-chart-core.js" asp-append-version="true"></script>
    <script src="~/js/energy-dashboard.js" asp-append-version="true"></script>
}