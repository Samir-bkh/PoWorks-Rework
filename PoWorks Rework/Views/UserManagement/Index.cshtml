@model IEnumerable<PoWorks_Rework.Controllers.UserViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>User Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add New User
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Profile</th>
                        <th>Assignment</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-bold" style="vertical-align: middle;">@user.UserName</td>
                            <td style="vertical-align: middle;">
                                @if (user.UserType == "Admin")
                                {
                                    <span class="badge bg-dark">Admin</span>
                                }
                                else if (user.UserType == "Tenant")
                                {
                                    <span class="badge bg-success">Tenant</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Management</span>
                                }
                            </td>
                            <td style="vertical-align: middle;">
                                @if (user.UserType == "Tenant")
                                {
                                    <span class="badge bg-info text-dark">@(!string.IsNullOrWhiteSpace(user.TenantName) ? user.TenantName : $"Tenant #{user.TenantId}")</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@user.CompanyName</span>
                                }
                            </td>
                            <td class="text-end" style="vertical-align: middle;">
                                @if (!string.Equals(user.UserName, "admin", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">System Admin</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>