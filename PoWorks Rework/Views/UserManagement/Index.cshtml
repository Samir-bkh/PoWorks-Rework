@model IEnumerable<PoWorks_Rework.Controllers.UserViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">User Management</h2>
            <p class="text-muted mb-0">Manage access without deleting company, tenant or metering data.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add New User
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Username</th>
                            <th>Profile</th>
                            <th>Assignment</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-bold">@user.UserName</td>
                                <td>
                                    @if (user.UserType == "Admin")
                                    {
                                        <span class="badge bg-dark">Admin</span>
                                    }
                                    else if (user.UserType == "Tenant")
                                    {
                                        <span class="badge bg-success">Tenant</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Management</span>
                                    }
                                </td>
                                <td>
                                    @if (user.UserType == "Tenant")
                                    {
                                        <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(user.TenantName) ? user.TenantName : $"Tenant #{user.TenantId}")</div>
                                        <small class="text-muted">@user.CompanyName</small>
                                    }
                                    else
                                    {
                                        <span>@user.CompanyName</span>
                                    }
                                </td>
                                <td>
                                    @if (user.UserType == "Admin")
                                    {
                                        <span class="badge bg-success">Protected</span>
                                    }
                                    else if (user.IsEnabled)
                                    {
                                        <span class="badge bg-success">Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Disabled</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!string.Equals(user.UserName, "admin", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>

                                        @if (user.IsEnabled)
                                        {
                                            <form asp-action="DisableUser" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning"
                                                        onclick="return confirm('Disable this user? The account will no longer be able to sign in.');">
                                                    <i class="bi bi-person-slash"></i> Disable
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="EnableUser" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-person-check"></i> Enable
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this login account? Company, tenant, meters, readings, bills and payments will be preserved.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">System Admin</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>