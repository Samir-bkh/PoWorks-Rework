@model PoWorks_Rework.Controllers.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h4 class="mb-0">Create New User</h4>
                </div>
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(string.Empty, new { @class = "mb-0" })
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        
                        <!-- Username -->
                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <input type="text" asp-for="Username" class="form-control" required />
                        </div>
                        
                        <!-- Company Selection -->
                        <div class="mb-3">
                            <label for="companyId" class="form-label">Company / Project</label>
                            <select asp-for="CompanyId" id="companyId" class="form-control" onchange="toggleNewCompanyField()">
                                @foreach (var item in (List<SelectListItem>)ViewBag.Companies)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <div class="form-text">Select an existing company or create a new one for this user.</div>
                        </div>

                        <div class="mb-3" id="newCompanyField" style="display:none;">
                            <label for="newCompanyName" class="form-label">New Company Name</label>
                            <input type="text" asp-for="NewCompanyName" id="newCompanyName" class="form-control" placeholder="e.g. Central Hospital" />
                        </div>

                        <!-- Password -->
                        <div class="mb-4">
                            <label class="form-label">Password</label>
                            <input type="password" asp-for="Password" class="form-control" required />
                            <div class="form-text">Requires at least 6 characters, uppercase, lowercase, number, and special character.</div>
                        </div>

                        <!-- Bloc Permissions -->
                        <div class="mb-4 p-3 border rounded bg-light">
                            <label class="form-label fw-bold mb-3"><i class="bi bi-shield-lock"></i> Access Permissions</label>
                            
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="CanViewPcVueConfig">
                                <label class="form-check-label" asp-for="CanViewPcVueConfig">Allow access to <strong>PcVue Config</strong></label>
                            </div>
                            
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="CanViewImportExport">
                                <label class="form-check-label" asp-for="CanViewImportExport">Allow access to <strong>Import/Export</strong></label>
                            </div>
                            
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="CanViewGeneralSettings">
                                <label class="form-check-label text-danger" asp-for="CanViewGeneralSettings">Allow access to <strong>General Settings (Database & Server)</strong></label>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Create User</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleNewCompanyField() {
            var select = document.getElementById('companyId');
            var field = document.getElementById('newCompanyField');
            field.style.display = select.value === 'NEW' ? 'block' : 'none';
        }
        
  
        document.addEventListener("DOMContentLoaded", toggleNewCompanyField);
    </script>
}